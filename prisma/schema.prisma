generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["apic_catalog", "apic_governance", "apic_runtime", "apic_audit"]
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  services Service[]
  tribes   Tribe[]
  members  OrganizationMember[]

  @@map("organizations")
  @@schema("apic_catalog")
}

/// A person allowed to use the management console for one organization. Platform admins are not rows here.
model OrganizationMember {
  organizationId String   @map("organization_id") @db.Uuid
  email          String
  /// owner, admin, developer or viewer. Legacy values: operator = developer, observer = viewer.
  role           String
  /// Verified identity subject, linked on first verified sign-in.
  subject        String?
  status         String   @default("active")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, email], name: "organization_members_pkey")
  @@index([email], name: "organization_members_email_idx")
  @@map("organization_members")
  @@schema("apic_catalog")
}

/// A tribe is the people and ownership boundary: admins, approvals, an optional tribe-wide quota ceiling,
/// and reporting rollups. It owns projects; it never owns services directly.
model Tribe {
  tribeId        String   @id @map("tribe_id")
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  @@map("tribes")
  @@schema("apic_catalog")
}

/// A project is a product or application inside a tribe. It owns plans, quota budgets, and cost attribution.
/// Every tribe-type service belongs to exactly one project. A project never moves between tribes.
model Project {
  projectId   String   @id @map("project_id")
  tribeId     String   @map("tribe_id")
  name        String
  description String?
  costCenter  String?  @map("cost_center")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tribe    Tribe     @relation(fields: [tribeId], references: [tribeId])
  services Service[]

  @@unique([projectId, tribeId], name: "projects_project_tribe_unique")
  @@index([tribeId, status], name: "projects_tribe_status_idx")
  @@map("projects")
  @@schema("apic_catalog")
}

model Service {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  serviceId            String    @map("service_id")
  name                 String
  serviceType          String    @map("service_type")
  baseUrl              String    @map("base_url")
  healthCheckPath      String?   @map("health_check_path")
  status               String    @default("active")
  version              String?
  previousVersion      String?   @map("previous_version")
  description          String?
  tags                 Json      @default("[]")
  projectId            String?   @map("project_id")
  ownerTribeId         String?   @map("owner_tribe_id")
  ownerTeam            String?   @map("owner_team")
  contact              String?
  serviceTier          String?   @map("service_tier")
  costCenter           String?   @map("cost_center")
  sunsetDate           DateTime? @map("sunset_date") @db.Timestamptz(6)
  replacementServiceId String?   @map("replacement_service_id")
  healthy              Boolean?
  lastHealthCheckAt    DateTime? @map("last_health_check_at") @db.Timestamptz(6)
  registeredAt         DateTime  @default(now()) @map("registered_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization            @relation(fields: [organizationId], references: [id])
  project            Project?                @relation(fields: [projectId, ownerTribeId], references: [projectId, tribeId])
  routes             ServiceRoute[]
  scopes             ServiceScope[]
  dependencies       ServiceDependency[]     @relation("ServiceDependencies")
  dependedOnBy       ServiceDependency[]     @relation("DependsOnService")
  lifecycleEvents    ServiceLifecycleEvent[]
  environments       ServiceEnvironment[]
  specVersions       ServiceSpecVersion[]

  @@unique([organizationId, serviceId], name: "organization_service_id")
  @@index([serviceType, status], name: "services_type_status_idx")
  @@index([ownerTribeId], name: "services_owner_tribe_idx")
  @@index([projectId], name: "services_project_idx")
  @@index([organizationId, ownerTribeId, serviceType, status], name: "services_org_owner_type_status_idx")
  @@index([ownerTeam], name: "services_owner_team_idx")
  @@map("services")
  @@schema("apic_catalog")
}

model ServiceSpecVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId   String   @map("service_id") @db.Uuid
  version     String
  format      String
  document    Json
  sha256      String   @db.Char(64)
  publishedBy String   @map("published_by")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([serviceId, version], name: "service_spec_versions_service_version_key")
  @@unique([serviceId, sha256], name: "service_spec_versions_service_sha256_key")
  @@index([serviceId, publishedAt(sort: Desc)], name: "service_spec_versions_service_published_idx")
  @@map("service_spec_versions")
  @@schema("apic_catalog")
}

model ServiceEnvironment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId         String    @map("service_id") @db.Uuid
  environment       String
  baseUrl           String    @map("base_url")
  healthCheckPath   String?   @map("health_check_path")
  status            String    @default("active")
  healthy           Boolean?
  lastHealthCheckAt DateTime? @map("last_health_check_at") @db.Timestamptz(6)
  registeredAt      DateTime  @default(now()) @map("registered_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, environment], name: "service_environment_unique")
  @@index([environment, status], name: "service_environments_env_status_idx")
  @@map("service_environments")
  @@schema("apic_catalog")
}

model ServiceRoute {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId   String   @map("service_id") @db.Uuid
  method      String?
  path        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, method, path])
  @@map("service_routes")
  @@schema("apic_catalog")
}

model ServiceScope {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  scope     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, scope])
  @@map("service_scopes")
  @@schema("apic_catalog")
}

model ServiceDependency {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId           String   @map("service_id") @db.Uuid
  dependsOnServiceId  String?  @map("depends_on_service_id") @db.Uuid
  dependsOnExternalId String?  @map("depends_on_external_id")
  dependencyType      String   @default("consumes") @map("dependency_type")
  required            Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service          Service  @relation("ServiceDependencies", fields: [serviceId], references: [id], onDelete: Cascade)
  dependsOnService Service? @relation("DependsOnService", fields: [dependsOnServiceId], references: [id])

  @@index([serviceId], name: "service_dependencies_service_idx")
  @@index([dependsOnServiceId], name: "service_dependencies_depends_on_idx")
  @@map("service_dependencies")
  @@schema("apic_catalog")
}

model ServiceLifecycleEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  eventType       String   @map("event_type")
  previousStatus  String?  @map("previous_status")
  nextStatus      String?  @map("next_status")
  previousVersion String?  @map("previous_version")
  nextVersion     String?  @map("next_version")
  actorType       String   @default("system") @map("actor_type")
  actorId         String?  @map("actor_id")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_lifecycle_events")
  @@schema("apic_catalog")
}

model ConfluentTopic {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicName         String    @unique @map("topic_name")
  ownerServiceId    String?   @map("owner_service_id") @db.Uuid
  topicType         String    @map("topic_type")
  partitions        Int       @default(1)
  retentionMs       BigInt?   @map("retention_ms")
  cleanupPolicy     String    @default("delete") @map("cleanup_policy")
  existsInConfluent Boolean   @default(false) @map("exists_in_confluent")
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamptz(6)
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  s3SinkTopics S3SinkTopic[]

  @@map("confluent_topics")
  @@schema("apic_runtime")
}

model S3SinkTopic {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId       String    @map("topic_id") @db.Uuid
  connectorName String    @map("connector_name")
  included      Boolean   @default(false)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  topic ConfluentTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, connectorName])
  @@map("s3_sink_topics")
  @@schema("apic_runtime")
}

model RegistryChangeRequest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId        String    @map("service_id")
  ownerTribeId     String?   @map("owner_tribe_id")
  projectId        String?   @map("project_id")
  status           String    @default("pending")
  manifest         Json
  validationReport Json      @default("{}") @map("validation_report")
  requestedBy      String?   @map("requested_by")
  approvedBy       String?   @map("approved_by")
  rejectedBy       String?   @map("rejected_by")
  rejectionReason  String?   @map("rejection_reason")
  appliedServiceId String?   @map("applied_service_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(6)
  appliedAt        DateTime? @map("applied_at") @db.Timestamptz(6)

  @@index([status, createdAt], name: "registry_change_requests_status_created_idx")
  @@index([serviceId], name: "registry_change_requests_service_idx")
  @@index([ownerTribeId], name: "registry_change_requests_owner_idx")
  @@index([projectId], name: "registry_change_requests_project_idx")
  @@map("registry_change_requests")
  @@schema("apic_governance")
}

model PipelineFeedbackActionRecord {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action        String
  environment   String
  targetType    String   @map("target_type")
  targetId      String   @map("target_id")
  ownerTribeId  String?  @map("owner_tribe_id")
  evidenceLink  String?  @map("evidence_link")
  reason        String
  actorId       String   @map("actor_id")
  actorRole     String   @map("actor_role")
  correlationId String?  @map("correlation_id")
  status        String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([environment, targetId, createdAt], name: "pipeline_feedback_actions_env_target_idx")
  @@index([status, createdAt], name: "pipeline_feedback_actions_status_created_idx")
  @@index([ownerTribeId, createdAt], name: "pipeline_feedback_actions_owner_idx")
  @@index([correlationId], name: "pipeline_feedback_actions_correlation_idx")
  @@map("pipeline_feedback_actions")
  @@schema("apic_runtime")
}

model EventTopicOnboardingState {
  physicalTopic String   @id @map("physical_topic")
  environment   String
  ownerTribeId  String?  @map("owner_tribe_id")
  record        Json
  updatedBy     String?  @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([environment, ownerTribeId], name: "event_topic_onboarding_states_env_owner_idx")
  @@index([updatedAt], name: "event_topic_onboarding_states_updated_idx")
  @@map("event_topic_onboarding_states")
  @@schema("apic_runtime")
}

model AuditEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correlationId   String?  @map("correlation_id")
  environment     String
  sourceServiceId String?  @map("source_service_id")
  serviceId       String?  @map("service_id")
  tribeId         String?  @map("tribe_id")
  actorType       String   @default("system") @map("actor_type")
  actorId         String?  @map("actor_id")
  action          String
  resourceType    String   @map("resource_type")
  resourceId      String?  @map("resource_id")
  outcome         String   @default("succeeded")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], name: "audit_events_created_idx")
  @@index([resourceType, resourceId, createdAt], name: "audit_events_resource_idx")
  @@index([actorType, actorId, createdAt], name: "audit_events_actor_idx")
  @@index([environment, resourceType, resourceId, correlationId, createdAt], name: "audit_events_env_resource_correlation_idx")
  @@index([sourceServiceId, environment, createdAt], name: "audit_events_source_env_created_idx")
  @@index([tribeId, environment, createdAt], name: "audit_events_tribe_env_created_idx")
  @@map("audit_events")
  @@schema("apic_audit")
}

model UsageRollup {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  windowStart       DateTime @map("window_start") @db.Timestamptz(6)
  windowEnd         DateTime @map("window_end") @db.Timestamptz(6)
  environment       String
  consumerServiceId String?  @map("consumer_service_id") @db.Uuid
  targetServiceId   String?  @map("target_service_id") @db.Uuid
  routeFamily       String   @map("route_family")
  requestCount      Int      @default(0) @map("request_count")
  successCount      Int      @default(0) @map("success_count")
  errorCount        Int      @default(0) @map("error_count")
  avgLatencyMs      Decimal? @map("avg_latency_ms") @db.Decimal(10, 2)
  p95LatencyMs      Int?     @map("p95_latency_ms")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([environment, consumerServiceId, targetServiceId, routeFamily, windowStart, windowEnd], name: "usage_rollups_env_service_target_window_uidx")
  @@index([environment, windowStart], name: "usage_rollups_environment_window_idx")
  @@map("usage_rollups")
  @@schema("apic_runtime")
}

model QuotaPolicy {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerTribeId    String   @map("owner_tribe_id")
  /// Null means a tribe-wide ceiling; set means this project's budget.
  projectId       String?  @map("project_id")
  scope           String   @default("all")
  targetServiceId String?  @map("target_service_id")
  windowSeconds   Int      @map("window_seconds")
  maxRequests     Int      @map("max_requests")
  burstRequests   Int?     @map("burst_requests")
  mode            String   @default("observe")
  status          String   @default("active")
  reason          String
  createdBy       String?  @map("created_by")
  updatedBy       String?  @map("updated_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerTribeId, status], name: "quota_policies_owner_status_idx")
  @@index([projectId, status], name: "quota_policies_project_status_idx")
  @@index([scope, targetServiceId], name: "quota_policies_scope_target_idx")
  @@map("quota_policies")
  @@schema("apic_governance")
}

model QuotaEvaluation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerTribeId    String   @map("owner_tribe_id")
  projectId       String?  @map("project_id")
  environment     String
  policyId        String?  @map("policy_id") @db.Uuid
  scope           String
  targetServiceId String?  @map("target_service_id")
  routeFamily     String   @map("route_family")
  windowStart     DateTime @map("window_start") @db.Timestamptz(6)
  windowEnd       DateTime @map("window_end") @db.Timestamptz(6)
  requestCount    Int      @map("request_count")
  maxRequests     Int      @map("max_requests")
  mode            String
  outcome         String
  correlationId   String?  @map("correlation_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerTribeId, createdAt], name: "quota_evaluations_owner_created_idx")
  @@index([outcome, createdAt], name: "quota_evaluations_outcome_created_idx")
  @@index([correlationId], name: "quota_evaluations_correlation_idx")
  @@index([environment, ownerTribeId, createdAt], name: "quota_evaluations_environment_owner_created_idx")
  @@index([environment, ownerTribeId, routeFamily, windowStart], name: "quota_evaluations_env_route_window_idx")
  @@index([environment, projectId, createdAt], name: "quota_evaluations_environment_project_created_idx")
  @@map("quota_evaluations")
  @@schema("apic_runtime")
}

model EntitlementAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerTribeId String   @map("owner_tribe_id")
  projectId    String   @map("project_id")
  planKey      String   @map("plan_key")
  environment  String
  status       String   @default("active")
  effectiveAt  DateTime @map("effective_at") @db.Timestamptz(6)
  reason       String
  assignedBy   String?  @map("assigned_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerTribeId, environment, status], name: "entitlement_assignments_owner_env_status_idx")
  @@index([projectId, environment, status], name: "entitlement_assignments_project_env_status_idx")
  @@index([planKey, environment], name: "entitlement_assignments_plan_env_idx")
  // Partial unique index for active assignments is maintained by SQL migration.
  @@map("entitlement_assignments")
  @@schema("apic_governance")
}

model ApprovalRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actionType        String    @map("action_type")
  targetId          String?   @map("target_id")
  targetEnvironment String    @map("target_environment")
  status            String    @default("pending")
  before            Json
  after             Json
  riskLevel         String    @map("risk_level")
  reason            String
  requestedBy       String    @map("requested_by")
  approvedBy        String?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectedBy        String?   @map("rejected_by")
  rejectedAt        DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectionReason   String?   @map("rejection_reason")
  cancelledBy       String?   @map("cancelled_by")
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  appliedAt         DateTime? @map("applied_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt], name: "approval_requests_status_created_idx")
  @@index([actionType, targetEnvironment], name: "approval_requests_action_env_idx")
  @@index([targetId], name: "approval_requests_target_idx")
  @@map("approval_requests")
  @@schema("apic_governance")
}

/// Cross-project API access requests. Domain identifiers intentionally have no relations/FKs.
model ApiSubscription {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumerProjectId String    @map("consumer_project_id")
  apiProjectId      String    @map("api_project_id")
  apiServiceId      String    @map("api_service_id")
  environment       String
  status            String    @default("pending")
  requestedBy       String    @map("requested_by")
  decidedBy         String?   @map("decided_by")
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(6)
  reason            String?
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([consumerProjectId, environment, status, requestedAt(sort: Desc)], name: "api_subscriptions_consumer_idx")
  @@index([apiProjectId, apiServiceId, environment, status, requestedAt(sort: Desc)], name: "api_subscriptions_api_idx")
  @@map("api_subscriptions")
  @@schema("apic_governance")
}

// ── Control plane v2 (rebuild slice 1) ──────────────────────────────────────
// Organization-owned projects with environment-bound applications, explicit grants and
// credentials. Ownership tuples are enforced by composite foreign keys in
// supabase/migrations/20261114000100_control_plane_foundation.sql. No tribe.

/// A product owned directly by an organization.
model CpProject {
  id             String   @id
  organizationId String   @map("organization_id") @db.Uuid
  slug           String
  name           String
  status         String   @default("active")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@map("cp_projects")
  @@schema("apic_catalog")
}

/// An isolated test or live workspace of a project. Kind and ownership are immutable.
model CpEnvironment {
  id             String   @id
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id")
  kind           String
  /// provisioning (live only, before approval), active or suspended.
  status         String   @default("active")
  activatedAt    DateTime? @map("activated_at") @db.Timestamptz(6)
  activatedBy    String?   @map("activated_by")
  activationApprovalId String? @map("activation_approval_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, kind])
  @@unique([id, projectId, organizationId])
  @@map("cp_environments")
  @@schema("apic_catalog")
}

/// A backend, worker or integration identity that calls APIs from one environment.
model CpApplication {
  id                   String   @id
  organizationId       String   @map("organization_id") @db.Uuid
  projectId            String   @map("project_id")
  environmentId        String   @map("environment_id")
  slug                 String
  name                 String
  status               String   @default("active")
  authorizationVersion Int      @default(1) @map("authorization_version")
  createdBy            String   @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([environmentId, slug])
  @@unique([id, environmentId, projectId, organizationId])
  @@map("cp_applications")
  @@schema("apic_catalog")
}

/// A platform capability enabled for one environment. Enabling it grants no application access.
model CpCapabilityInstallation {
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id")
  environmentId  String   @map("environment_id")
  capability     String
  status         String   @default("enabled")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([environmentId, capability])
  @@map("cp_capability_installations")
  @@schema("apic_catalog")
}

/// Explicit permission for one application to perform one catalogued action.
model CpApplicationGrant {
  id             String    @id
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id")
  environmentId  String    @map("environment_id")
  applicationId  String    @map("application_id")
  targetKind     String    @map("target_kind")
  targetId       String    @map("target_id")
  action         String
  status         String    @default("active")
  provenance     String    @default("explicit")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedBy      String?   @map("revoked_by")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  // One active grant per application/target/action is a partial unique index in SQL.
  @@map("cp_application_grants")
  @@schema("apic_catalog")
}

/// Environment-bound application credential. Only a SHA-256 verifier is stored.
model CpCredential {
  id              String    @id
  organizationId  String    @map("organization_id") @db.Uuid
  projectId       String    @map("project_id")
  environmentId   String    @map("environment_id")
  applicationId   String    @map("application_id")
  environmentKind String    @map("environment_kind")
  lookupPrefix    String    @unique @map("lookup_prefix")
  verifierSha256  String    @map("verifier_sha256") @db.Char(64)
  status          String    @default("active")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedBy       String?   @map("revoked_by")
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?   @map("revoked_reason")

  @@index([applicationId, status], name: "cp_credentials_application_idx")
  @@map("cp_credentials")
  @@schema("apic_catalog")
}

/// Credential issuance receipt keyed by the caller's operation ID.
model CpCredentialOperation {
  operationId    String   @id @map("operation_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  applicationId  String   @map("application_id")
  fingerprint    String   @db.Char(64)
  credentialId   String   @map("credential_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("cp_credential_operations")
  @@schema("apic_catalog")
}

/// Optional group of organization members that receives project roles.
model CpTeam {
  id             String   @id
  organizationId String   @map("organization_id") @db.Uuid
  slug           String
  name           String
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@map("cp_teams")
  @@schema("apic_catalog")
}

model CpTeamMember {
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id")
  email          String
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([teamId, email])
  @@map("cp_team_members")
  @@schema("apic_catalog")
}

/// A project role granted to exactly one member or one team.
model CpProjectRoleAssignment {
  id             String   @id
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id")
  memberEmail    String?  @map("member_email")
  teamId         String?  @map("team_id")
  role           String
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("cp_project_role_assignments")
  @@schema("apic_catalog")
}

/// The plan assigned to one project environment. One active entitlement per environment.
model CpEntitlement {
  id             String    @id
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id")
  environmentId  String    @map("environment_id")
  planKey        String    @map("plan_key")
  status         String    @default("active")
  assignedBy     String    @map("assigned_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)

  @@map("cp_entitlements")
  @@schema("apic_catalog")
}

/// A request budget for one project environment kind, or a shared ceiling over covered projects.
model CpQuotaPolicy {
  id              String   @id
  organizationId  String   @map("organization_id") @db.Uuid
  scope           String
  projectId       String?  @map("project_id")
  environmentKind String   @map("environment_kind")
  capability      String?
  windowSeconds   Int      @map("window_seconds")
  maxRequests     Int      @map("max_requests")
  mode            String   @default("enforce")
  status          String   @default("active")
  provenance      String   @default("explicit")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([id, organizationId])
  @@map("cp_quota_policies")
  @@schema("apic_catalog")
}

model CpQuotaPolicyProject {
  organizationId String @map("organization_id") @db.Uuid
  policyId       String @map("policy_id")
  projectId      String @map("project_id")

  @@id([policyId, projectId])
  @@map("cp_quota_policy_projects")
  @@schema("apic_catalog")
}

model CpQuotaCounter {
  organizationId String   @map("organization_id") @db.Uuid
  budgetKey      String   @map("budget_key")
  windowStart    DateTime @map("window_start") @db.Timestamptz(6)
  requestCount   Int      @map("request_count")

  @@id([budgetKey, windowStart])
  @@map("cp_quota_counters")
  @@schema("apic_catalog")
}

/// One admitted application request, counted once per request key.
model CpUsageRecord {
  organizationId String    @map("organization_id") @db.Uuid
  requestKey     String    @map("request_key")
  projectId      String    @map("project_id")
  environmentId  String    @map("environment_id")
  applicationId  String    @map("application_id")
  capability     String
  action         String
  outcome        String    @default("admitted")
  statusCode     Int?      @map("status_code")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  @@id([organizationId, requestKey])
  @@map("cp_usage_records")
  @@schema("apic_catalog")
}

/// The owner a project environment's runtime records are scoped to, when it differs from
/// (organization, project): a migrated project keeps its legacy (tribe, project) owner.
model CpResourceOwnerMapping {
  organizationId    String   @map("organization_id") @db.Uuid
  projectId         String   @map("project_id")
  environmentKind   String   @map("environment_kind")
  ownerGroupId      String   @map("owner_group_id")
  ownerProjectId    String   @map("owner_project_id")
  migrationRevision String   @map("migration_revision")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([projectId, environmentKind])
  @@map("cp_resource_owner_mappings")
  @@schema("apic_catalog")
}

/// An API a project publishes in one environment. Optional; calling APIs never requires it.
model CpPublishedApi {
  id              String   @id
  organizationId  String   @map("organization_id") @db.Uuid
  projectId       String   @map("project_id")
  environmentId   String   @map("environment_id")
  environmentKind String   @map("environment_kind")
  slug            String
  name            String
  upstreamUrl     String   @map("upstream_url")
  status          String   @default("active")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([environmentId, slug])
  @@unique([id, organizationId])
  @@map("cp_published_apis")
  @@schema("apic_catalog")
}

model CpPublishedApiOperation {
  organizationId String  @map("organization_id") @db.Uuid
  apiId          String  @map("api_id")
  method         String
  pathPattern    String  @map("path_pattern")
  action         String
  description    String?

  @@id([apiId, method, pathPattern])
  @@map("cp_published_api_operations")
  @@schema("apic_catalog")
}

/// A request for an application in another project to be granted an API action.
model CpApiAccessRequest {
  id                    String    @id
  organizationId        String    @map("organization_id") @db.Uuid
  apiId                 String    @map("api_id")
  action                String
  consumerProjectId     String    @map("consumer_project_id")
  consumerEnvironmentId String    @map("consumer_environment_id")
  consumerApplicationId String    @map("consumer_application_id")
  status                String    @default("pending")
  requestedBy           String    @map("requested_by")
  decidedBy             String?   @map("decided_by")
  decidedAt             DateTime? @map("decided_at") @db.Timestamptz(6)
  grantId               String?   @map("grant_id")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("cp_api_access_requests")
  @@schema("apic_catalog")
}

/// Delivers one recipient application's events in one environment to a Pub/Sub push endpoint.
model CpEventDestination {
  id                          String   @id
  organizationId              String   @map("organization_id") @db.Uuid
  projectId                   String   @map("project_id")
  environmentId               String   @map("environment_id")
  recipientApplicationId      String   @map("recipient_application_id")
  eventFamily                 String   @default("payments") @map("event_family")
  transport                   String   @default("pubsub-push")
  pushEndpoint                String   @map("push_endpoint")
  oidcAudience                String?  @map("oidc_audience")
  deliveryServiceAccountEmail String   @map("delivery_service_account_email")
  subscriptionName            String?  @map("subscription_name")
  status                      String   @default("provisioning")
  lastError                   String?  @map("last_error")
  createdBy                   String   @map("created_by")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("cp_event_destinations")
  @@schema("apic_catalog")
}

/// Which control-plane record a legacy record became. Makes backfill idempotent.
model CpLegacyMapping {
  organizationId    String   @map("organization_id") @db.Uuid
  sourceKind        String   @map("source_kind")
  sourceId          String   @map("source_id")
  environmentKind   String   @default("") @map("environment_kind")
  targetKind        String   @map("target_kind")
  targetId          String   @map("target_id")
  migrationRevision String   @map("migration_revision")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([sourceKind, sourceId, environmentKind])
  @@map("cp_legacy_mappings")
  @@schema("apic_catalog")
}

/// Which model is authoritative for a migrated project environment. Transitions name the fence.
model CpControlPlaneAssignment {
  organizationId    String    @map("organization_id") @db.Uuid
  projectId         String    @map("project_id")
  environmentKind   String    @map("environment_kind")
  authority         String
  fenceVersion      Int       @default(0) @map("fence_version")
  legacyProjectId   String    @map("legacy_project_id")
  legacyTribeId     String    @map("legacy_tribe_id")
  migrationRevision String    @map("migration_revision")
  changedBy         String    @map("changed_by")
  changedAt         DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  cutOverAt         DateTime? @map("cut_over_at") @db.Timestamptz(6)

  @@id([projectId, environmentKind])
  @@map("cp_control_plane_assignments")
  @@schema("apic_catalog")
}

/// A legacy call whose new-model decision differs. Cutover waits until none is unresolved.
model CpShadowMismatch {
  organizationId  String    @map("organization_id") @db.Uuid
  projectId       String    @map("project_id")
  environmentKind String    @map("environment_kind")
  sourceServiceId String    @map("source_service_id")
  target          String
  action          String
  legacyAllowed   Boolean   @map("legacy_allowed")
  newAllowed      Boolean   @map("new_allowed")
  occurrences     Int       @default(1)
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy      String?   @map("resolved_by")
  resolution      String?

  @@id([projectId, environmentKind, sourceServiceId, target, action, legacyAllowed])
  @@map("cp_shadow_mismatches")
  @@schema("apic_catalog")
}

model CpMigrationRun {
  id                String   @id
  organizationId    String   @map("organization_id") @db.Uuid
  kind              String
  projectId         String?  @map("project_id")
  environmentKind   String?  @map("environment_kind")
  migrationRevision String   @map("migration_revision")
  report            Json     @default("{}")
  actor             String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("cp_migration_runs")
  @@schema("apic_catalog")
}

/// Binds one exact OIDC workload identity (issuer, subject, audience) to one application.
model CpWorkloadBinding {
  id             String    @id
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id")
  environmentId  String    @map("environment_id")
  applicationId  String    @map("application_id")
  issuer         String
  subject        String
  audience       String
  description    String?
  status         String    @default("active")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedBy      String?   @map("revoked_by")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@map("cp_workload_bindings")
  @@schema("apic_catalog")
}
