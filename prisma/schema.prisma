generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["api_center", "api_center_ops", "api_center_audit"]
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  services Service[]

  @@map("organizations")
  @@schema("api_center")
}

model Service {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  serviceId            String    @map("service_id")
  name                 String
  serviceType          String    @map("service_type")
  baseUrl              String    @map("base_url")
  healthCheckPath      String?   @map("health_check_path")
  status               String    @default("active")
  version              String?
  previousVersion      String?   @map("previous_version")
  description          String?
  tags                 Json      @default("[]")
  ownerTribeId         String?   @map("owner_tribe_id")
  ownerTeam            String?   @map("owner_team")
  contact              String?
  serviceTier          String?   @map("service_tier")
  costCenter           String?   @map("cost_center")
  sunsetDate           DateTime? @map("sunset_date") @db.Timestamptz(6)
  replacementServiceId String?   @map("replacement_service_id")
  healthy              Boolean?
  lastHealthCheckAt    DateTime? @map("last_health_check_at") @db.Timestamptz(6)
  registeredAt         DateTime  @default(now()) @map("registered_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization            @relation(fields: [organizationId], references: [id])
  routes             ServiceRoute[]
  scopes             ServiceScope[]
  dependencies       ServiceDependency[]     @relation("ServiceDependencies")
  dependedOnBy       ServiceDependency[]     @relation("DependsOnService")
  lifecycleEvents    ServiceLifecycleEvent[]
  environments       ServiceEnvironment[]
  tribeSecretRef     TribeSecretRef?
  confluentTopics    ConfluentTopic[]
  provisioningJobs   ProvisioningJob[]
  healthSnapshots    HealthSnapshot[]
  smokeTestRuns      SmokeTestRun[]          @relation("SmokeTestService")
  tribeSmokeTestRuns SmokeTestRun[]          @relation("SmokeTestTribe")
  usageAsConsumer    UsageRollup[]           @relation("UsageConsumer")
  usageAsTarget      UsageRollup[]           @relation("UsageTarget")

  @@unique([organizationId, serviceId], name: "organization_service_id")
  @@index([serviceType, status], name: "services_type_status_idx")
  @@index([ownerTribeId], name: "services_owner_tribe_idx")
  @@index([organizationId, ownerTribeId, serviceType, status], name: "services_org_owner_type_status_idx")
  @@index([ownerTeam], name: "services_owner_team_idx")
  @@map("services")
  @@schema("api_center")
}

model ServiceEnvironment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId         String    @map("service_id") @db.Uuid
  environment       String
  baseUrl           String    @map("base_url")
  healthCheckPath   String?   @map("health_check_path")
  status            String    @default("active")
  healthy           Boolean?
  lastHealthCheckAt DateTime? @map("last_health_check_at") @db.Timestamptz(6)
  registeredAt      DateTime  @default(now()) @map("registered_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, environment], name: "service_environment_unique")
  @@index([environment, status], name: "service_environments_env_status_idx")
  @@map("service_environments")
  @@schema("api_center")
}

model ServiceRoute {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId   String   @map("service_id") @db.Uuid
  method      String?
  path        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, method, path])
  @@map("service_routes")
  @@schema("api_center")
}

model ServiceScope {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  scope     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, scope])
  @@map("service_scopes")
  @@schema("api_center")
}

model ServiceDependency {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId           String   @map("service_id") @db.Uuid
  dependsOnServiceId  String?  @map("depends_on_service_id") @db.Uuid
  dependsOnExternalId String?  @map("depends_on_external_id")
  dependencyType      String   @default("consumes") @map("dependency_type")
  required            Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service          Service  @relation("ServiceDependencies", fields: [serviceId], references: [id], onDelete: Cascade)
  dependsOnService Service? @relation("DependsOnService", fields: [dependsOnServiceId], references: [id])

  @@index([serviceId], name: "service_dependencies_service_idx")
  @@index([dependsOnServiceId], name: "service_dependencies_depends_on_idx")
  @@map("service_dependencies")
  @@schema("api_center")
}

model ServiceLifecycleEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  eventType       String   @map("event_type")
  previousStatus  String?  @map("previous_status")
  nextStatus      String?  @map("next_status")
  previousVersion String?  @map("previous_version")
  nextVersion     String?  @map("next_version")
  actorType       String   @default("system") @map("actor_type")
  actorId         String?  @map("actor_id")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_lifecycle_events")
  @@schema("api_center")
}

model TribeSecretRef {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId         String    @unique @map("service_id") @db.Uuid
  secretManagerName String    @map("secret_manager_name")
  latestVersion     String?   @map("latest_version")
  status            String    @default("active")
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("tribe_secret_refs")
  @@schema("api_center")
}

model ConfluentTopic {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicName         String    @unique @map("topic_name")
  ownerServiceId    String?   @map("owner_service_id") @db.Uuid
  topicType         String    @map("topic_type")
  partitions        Int       @default(1)
  retentionMs       BigInt?   @map("retention_ms")
  cleanupPolicy     String    @default("delete") @map("cleanup_policy")
  existsInConfluent Boolean   @default(false) @map("exists_in_confluent")
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamptz(6)
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerService Service?      @relation(fields: [ownerServiceId], references: [id], onDelete: SetNull)
  s3SinkTopics S3SinkTopic[]

  @@map("confluent_topics")
  @@schema("api_center")
}

model S3SinkTopic {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId       String    @map("topic_id") @db.Uuid
  connectorName String    @map("connector_name")
  included      Boolean   @default(false)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  topic ConfluentTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, connectorName])
  @@map("s3_sink_topics")
  @@schema("api_center")
}

model ProvisioningJob {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId    String?   @map("service_id") @db.Uuid
  jobType      String    @map("job_type")
  status       String    @default("pending")
  requestedBy  String?   @map("requested_by")
  request      Json      @default("{}")
  result       Json      @default("{}")
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([serviceId], name: "provisioning_jobs_service_idx")
  @@index([status, createdAt], name: "provisioning_jobs_status_created_idx")
  @@map("provisioning_jobs")
  @@schema("api_center_ops")
}

model ServiceRegistrationRequest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId        String    @map("service_id")
  ownerTribeId     String    @map("owner_tribe_id")
  status           String    @default("pending")
  manifest         Json
  validationReport Json      @default("{}") @map("validation_report")
  requestedBy      String?   @map("requested_by")
  approvedBy       String?   @map("approved_by")
  rejectedBy       String?   @map("rejected_by")
  rejectionReason  String?   @map("rejection_reason")
  appliedServiceId String?   @map("applied_service_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(6)
  appliedAt        DateTime? @map("applied_at") @db.Timestamptz(6)

  @@index([status, createdAt], name: "service_registration_requests_status_created_idx")
  @@index([serviceId], name: "service_registration_requests_service_idx")
  @@index([ownerTribeId], name: "service_registration_requests_owner_idx")
  @@map("service_registration_requests")
  @@schema("api_center_ops")
}

model PipelineFeedbackActionRecord {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action        String
  environment   String
  targetType    String   @map("target_type")
  targetId      String   @map("target_id")
  ownerTribeId  String?  @map("owner_tribe_id")
  evidenceLink  String?  @map("evidence_link")
  reason        String
  actorId       String   @map("actor_id")
  actorRole     String   @map("actor_role")
  correlationId String?  @map("correlation_id")
  status        String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([environment, targetId, createdAt], name: "pipeline_feedback_actions_env_target_idx")
  @@index([status, createdAt], name: "pipeline_feedback_actions_status_created_idx")
  @@index([ownerTribeId, createdAt], name: "pipeline_feedback_actions_owner_idx")
  @@index([correlationId], name: "pipeline_feedback_actions_correlation_idx")
  @@map("pipeline_feedback_actions")
  @@schema("api_center_ops")
}

model TopicOnboardingStateRecord {
  physicalTopic String   @id @map("physical_topic")
  environment   String
  ownerTribeId  String?  @map("owner_tribe_id")
  record        Json
  updatedBy     String?  @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([environment, ownerTribeId], name: "topic_onboarding_states_env_owner_idx")
  @@index([updatedAt], name: "topic_onboarding_states_updated_idx")
  @@map("topic_onboarding_states")
  @@schema("api_center_ops")
}

model AuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correlationId String?  @map("correlation_id")
  actorType     String   @default("system") @map("actor_type")
  actorId       String?  @map("actor_id")
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  outcome       String   @default("succeeded")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], name: "audit_events_created_idx")
  @@index([resourceType, resourceId, createdAt], name: "audit_events_resource_idx")
  @@index([actorType, actorId, createdAt], name: "audit_events_actor_idx")
  @@map("audit_events")
  @@schema("api_center_audit")
}

model HealthSnapshot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId    String   @map("service_id") @db.Uuid
  healthy      Boolean
  statusCode   Int?     @map("status_code")
  latencyMs    Int?     @map("latency_ms")
  errorMessage String?  @map("error_message")
  checkedAt    DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("health_snapshots")
  @@schema("api_center_ops")
}

model SmokeTestRun {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId         String?  @map("service_id") @db.Uuid
  tribeServiceId    String?  @map("tribe_service_id") @db.Uuid
  testType          String   @map("test_type")
  providerImpacting Boolean  @default(false) @map("provider_impacting")
  status            String
  statusCode        Int?     @map("status_code")
  latencyMs         Int?     @map("latency_ms")
  responsePreview   String?  @map("response_preview")
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service      Service? @relation("SmokeTestService", fields: [serviceId], references: [id], onDelete: SetNull)
  tribeService Service? @relation("SmokeTestTribe", fields: [tribeServiceId], references: [id], onDelete: SetNull)

  @@map("smoke_test_runs")
  @@schema("api_center_ops")
}

model UsageRollup {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  windowStart       DateTime @map("window_start") @db.Timestamptz(6)
  windowEnd         DateTime @map("window_end") @db.Timestamptz(6)
  consumerServiceId String?  @map("consumer_service_id") @db.Uuid
  targetServiceId   String?  @map("target_service_id") @db.Uuid
  routeFamily       String   @map("route_family")
  requestCount      Int      @default(0) @map("request_count")
  successCount      Int      @default(0) @map("success_count")
  errorCount        Int      @default(0) @map("error_count")
  avgLatencyMs      Decimal? @map("avg_latency_ms") @db.Decimal(10, 2)
  p95LatencyMs      Int?     @map("p95_latency_ms")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  consumerService Service? @relation("UsageConsumer", fields: [consumerServiceId], references: [id], onDelete: SetNull)
  targetService   Service? @relation("UsageTarget", fields: [targetServiceId], references: [id], onDelete: SetNull)

  @@unique([windowStart, windowEnd, consumerServiceId, targetServiceId, routeFamily])
  @@map("usage_rollups")
  @@schema("api_center_ops")
}

model TribeApiQuotaPolicy {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerTribeId    String   @map("owner_tribe_id")
  scope           String   @default("all")
  targetServiceId String?  @map("target_service_id")
  windowSeconds   Int      @map("window_seconds")
  maxRequests     Int      @map("max_requests")
  burstRequests   Int?     @map("burst_requests")
  mode            String   @default("observe")
  status          String   @default("active")
  reason          String
  createdBy       String?  @map("created_by")
  updatedBy       String?  @map("updated_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerTribeId, status], name: "tribe_quota_policies_owner_status_idx")
  @@index([scope, targetServiceId], name: "tribe_quota_policies_scope_target_idx")
  @@map("tribe_api_quota_policies")
  @@schema("api_center_ops")
}

model TribeApiQuotaDecision {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerTribeId    String   @map("owner_tribe_id")
  policyId        String?  @map("policy_id") @db.Uuid
  scope           String
  targetServiceId String?  @map("target_service_id")
  routeFamily     String   @map("route_family")
  windowStart     DateTime @map("window_start") @db.Timestamptz(6)
  windowEnd       DateTime @map("window_end") @db.Timestamptz(6)
  requestCount    Int      @map("request_count")
  maxRequests     Int      @map("max_requests")
  mode            String
  outcome         String
  correlationId   String?  @map("correlation_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerTribeId, createdAt], name: "tribe_quota_decisions_owner_created_idx")
  @@index([outcome, createdAt], name: "tribe_quota_decisions_outcome_created_idx")
  @@index([correlationId], name: "tribe_quota_decisions_correlation_idx")
  @@map("tribe_api_quota_decisions")
  @@schema("api_center_ops")
}

model TribePlanDefinition {
  planKey              String   @id @map("plan_key")
  displayName          String   @map("display_name")
  gatewayCallsPerDay   Int?     @map("gateway_calls_per_day")
  kafkaPublishesPerDay Int?     @map("kafka_publishes_per_day")
  retentionTier        String   @map("retention_tier")
  sharedServiceAccess  String   @map("shared_service_access")
  supportTier          String   @map("support_tier")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tribe_plan_definitions")
  @@schema("api_center_ops")
}

model TribePlanAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerTribeId String   @map("owner_tribe_id")
  planKey      String   @map("plan_key")
  environment  String
  status       String   @default("active")
  effectiveAt  DateTime @map("effective_at") @db.Timestamptz(6)
  reason       String
  assignedBy   String?  @map("assigned_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerTribeId, environment, status], name: "tribe_plan_assignments_owner_env_status_idx")
  @@index([planKey, environment], name: "tribe_plan_assignments_plan_env_idx")
  @@map("tribe_plan_assignments")
  @@schema("api_center_ops")
}

model ApprovalRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actionType        String    @map("action_type")
  targetId          String?   @map("target_id")
  targetEnvironment String    @map("target_environment")
  status            String    @default("pending")
  before            Json
  after             Json
  riskLevel         String    @map("risk_level")
  reason            String
  requestedBy       String    @map("requested_by")
  approvedBy        String?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectedBy        String?   @map("rejected_by")
  rejectedAt        DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectionReason   String?   @map("rejection_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt], name: "approval_requests_status_created_idx")
  @@index([actionType, targetEnvironment], name: "approval_requests_action_env_idx")
  @@index([targetId], name: "approval_requests_target_idx")
  @@map("approval_requests")
  @@schema("api_center_ops")
}
