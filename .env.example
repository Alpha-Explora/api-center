# =============================================================================
# APICenter — Environment Variables
# =============================================================================
# Copy to .env:  cp .env.example .env
#
# The gateway reads these. Instances are interchangeable: durable state lives in Postgres.
#
# CORS:
#   ALLOWED_ORIGINS controls which browser origins receive
#   Access-Control-Allow-Origin. Set * for local dev.
#   In production use a comma-separated list of allowed origins.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS (required) ───────────────────────────────────────────────────────────
# Dev:  ALLOWED_ORIGINS=*
# Prod: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# ── Control plane ─────────────────────────────────────────────────────────────
# Signed runtime context (Ed25519). The gateway signs; runtimes verify.
# Generate: node scripts/control-plane/generate-runtime-context-key.cjs
# Without a signing key, ak_ application credentials fail closed with 503.
APICENTER_RUNTIME_CONTEXT_SIGNING_KEY=
# Runtimes (apps/email): JSON array of public JWKs.
APICENTER_RUNTIME_CONTEXT_PUBLIC_KEYS=

# Console identity: Google OAuth client IDs whose ID tokens the gateway accepts in
# X-APICenter-User-Token, so control-plane console calls act as the signed-in member.
MANAGEMENT_GOOGLE_CLIENT_IDS=
# Console sessions: the public half of the console's MANAGEMENT_SESSION_SIGNING_KEY, as a JSON array of
# Ed25519 public JWKs with kids. The gateway accepts X-APICenter-User-Session tokens signed by these keys.
MANAGEMENT_SESSION_PUBLIC_KEYS=

# Organizations allowed to use APICenter's payment merchant account (the internal bootstrap
# organization). Others cannot enable or call payments.
PAYMENTS_MERCHANT_ORGANIZATION_IDS=

# Local development only: allow http and private upstreams for published APIs. Ignored in production.
CONTROL_PLANE_ALLOW_PRIVATE_UPSTREAMS=false

# Workload identity: audiences the gateway accepts on Google-signed ID tokens (usually the gateway URL).
# Empty disables workload identity.
CONTROL_PLANE_WORKLOAD_AUDIENCES=

# Operators who act as admin in every organization (comma-separated emails).
PLATFORM_ADMIN_EMAILS=

# ── GCP Secret Manager ───────────────────────────────────────────────────────
# Set GCP_SECRET_NAME to load a JSON secret at startup and merge its keys
# into process.env (existing env vars are NOT overridden).
# Leave unset for local development — process.env is used directly.
#
# GCP_SECRET_NAME      Name of the secret in GCP Secret Manager (required to enable)
# GCP_PROJECT_ID       GCP project that owns the secret
#                      (falls back to GOOGLE_CLOUD_PROJECT if unset)
# GCP_SECRET_VERSION   Version to fetch (default: latest)
#
GCP_SECRET_NAME=
GCP_PROJECT_ID=
# GCP_SECRET_VERSION=latest

# -- Control-plane database --------------------------------------------------
# The control plane, approvals, idempotency and diagnostics live here. Required in production.
DATABASE_URL=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=api-center

# ── Platform admin ────────────────────────────────────────────────────────────
# Required in production. Generate: openssl rand -hex 32
PLATFORM_ADMIN_SECRET=

# APICenter payment platform
APICENTER_PAYMENTS_URL=http://localhost:4010
APICENTER_PAYMENTS_INTERNAL_TOKEN=local-payments-token
# Enable only when the Cloud Run service account can publish to both topics.
PUBSUB_DISPATCHER_ENABLED=false
APICENTER_PAYMENT_EVENTS_TOPIC_TEST=apicenter-payment-events-test
APICENTER_PAYMENT_EVENTS_TOPIC_LIVE=apicenter-payment-events-live

# Maximum gateway Postgres connections per instance (positive integer).
DATABASE_POOL_MAX=2
