FROM node:24-bookworm-slim AS workspace
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
COPY . .
RUN npm ci --include=dev --no-audit --no-fund \
    && npm run db:generate \
    && npm run build --workspace @alpha-explora/apicenter-contracts

FROM workspace AS builder
ARG APP
ARG GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
ENV MANAGEMENT_AUTH_MODE=google
RUN npm run build --workspace @apicenter/${APP} \
    && npm prune --omit=dev --no-audit --no-fund \
    && mkdir -p /app/apps/${APP}/node_modules

FROM node:24-bookworm-slim AS node-runtime
ARG APP
ENV APICENTER_APP=${APP} NODE_ENV=production PORT=8080
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/packages ./packages
COPY --from=builder --chown=node:node /app/apps/${APP} ./apps/${APP}
COPY --from=builder --chown=node:node /app/config ./config
WORKDIR /app/apps/${APP}
USER node
EXPOSE 8080
CMD ["sh", "-c", "if [ \"$APICENTER_APP\" = gateway ]; then exec node dist/main.js; elif [ \"$APICENTER_APP\" = management ]; then exec node ../../node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port \"$PORT\"; else exec node dist/server.js; fi"]

FROM nginxinc/nginx-unprivileged:stable-alpine AS docs-runtime
USER root
COPY docker/nginx.docs.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/docs/out /usr/share/nginx/html
USER 101
EXPOSE 8080
