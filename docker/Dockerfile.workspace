FROM node:24-bookworm-slim AS workspace
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
COPY . .
RUN npm ci --include=dev --no-audit --no-fund \
    && npm run db:generate \
    && npm run build --workspace @alpha-explora/apicenter-contracts

# Builds every app once and prunes once. It does not depend on APP, so each image below reuses this one cached stage,
# and the node_modules layer they copy is identical: the registry receives and stores it once.
FROM workspace AS builder
ARG GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
RUN MANAGEMENT_AUTH_MODE=google npm run build \
    && npm prune --omit=dev --no-audit --no-fund \
    && for app in apps/*; do mkdir -p "$app/node_modules"; done

# Everything the Node images share, built once. Nothing here depends on APP, so every image below reuses these
# layers as they are: the build copies node_modules once, and the registry stores and receives it once.
FROM node:24-bookworm-slim AS runtime-base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/packages ./packages
COPY --from=builder --chown=node:node /app/config ./config

FROM runtime-base AS node-runtime
ARG APP
COPY --from=builder --chown=node:node /app/apps/${APP} ./apps/${APP}
# The commit the image was built from; /api/v1/health/ready reports it.
ARG APICENTER_RELEASE_SHA=unknown
ENV APICENTER_APP=${APP} NODE_ENV=production PORT=8080 APICENTER_RELEASE_SHA=${APICENTER_RELEASE_SHA}
WORKDIR /app/apps/${APP}
USER node
EXPOSE 8080
CMD ["sh", "-c", "if [ \"$APICENTER_APP\" = gateway ]; then exec node dist/main.js; elif [ \"$APICENTER_APP\" = management ]; then exec node ../../node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port \"$PORT\"; else exec node dist/server.js; fi"]

FROM nginxinc/nginx-unprivileged:stable-alpine AS docs-runtime
USER root
COPY docker/nginx.docs.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/docs/out /usr/share/nginx/html
USER 101
EXPOSE 8080
