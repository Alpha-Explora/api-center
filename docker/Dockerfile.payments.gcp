FROM node:24-bookworm-slim AS builder

WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/ ./apps/
COPY packages/ ./packages/

RUN npm ci --include=dev --no-audit --no-fund \
    && npm run build --workspace @apicenter/contracts \
    && npm run build --workspace @apicenter/payments \
    && npm prune --omit=dev --no-audit --no-fund

FROM node:24-bookworm-slim AS runner

ENV NODE_ENV=production
ENV PORT=8080
WORKDIR /app

COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/packages/runtime ./packages/runtime
COPY --from=builder --chown=node:node /app/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=builder --chown=node:node /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=builder --chown=node:node /app/apps/payments/package.json ./apps/payments/package.json
COPY --from=builder --chown=node:node /app/apps/payments/dist ./apps/payments/dist
COPY --from=builder --chown=node:node /app/apps/payments/prisma ./apps/payments/prisma

WORKDIR /app/apps/payments
USER node
EXPOSE 8080
CMD ["node", "dist/server.js"]
