FROM node:24-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/ ./apps/
COPY packages/ ./packages/
COPY examples/ ./examples/
RUN npm ci --include=dev --no-audit --no-fund
ARG GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
RUN MANAGEMENT_AUTH_MODE=google npm run build --workspace @apicenter/management \
    && npm prune --omit=dev --no-audit --no-fund

FROM node:24-bookworm-slim AS runner
ENV NODE_ENV=production PORT=8080
WORKDIR /app
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/apps/management ./apps/management
COPY --from=builder --chown=node:node /app/packages ./packages
WORKDIR /app/apps/management
USER node
EXPOSE 8080
CMD ["sh", "-c", "exec node ../../node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port ${PORT}"]
