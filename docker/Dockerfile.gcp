# =============================================================================
# docker/Dockerfile.gcp — Cloud Run optimized image for APICenter
# =============================================================================
# Identical multi-stage structure to the root Dockerfile but tuned for GCP:
#  - Listens on PORT env var (Cloud Run injects this, default 8080)
#  - No NGINX — Cloud Run handles TLS termination and load balancing
#  - Credentials for GCP Secret Manager come from the attached service account
#    (Workload Identity) — no key files needed inside the image
# =============================================================================

# ---- Stage 1: Dependencies ----
FROM node:26-bookworm-slim AS deps

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --include=dev --no-fund

# ---- Stage 2: Build ----
FROM node:26-bookworm-slim AS builder

WORKDIR /app

# Reuse dependencies from the deps stage to avoid reinstalling on source changes
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json* ./

COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src/ ./src/
RUN npm run build && \
    npm prune --omit=dev && \
    npm cache clean --force

# ---- Stage 3: Production ----
FROM node:26-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --chown=node:node package.json package-lock.json* ./
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/dist ./dist

RUN mkdir -p /app/logs && chown node:node /app/logs

USER node

# Cloud Run injects PORT at runtime (default 8080)
ENV PORT=8080
EXPOSE 8080

CMD ["node", "dist/main.js"]
