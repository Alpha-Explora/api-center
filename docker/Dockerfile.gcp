# =============================================================================
# docker/Dockerfile.gcp — Cloud Run optimized image for APICenter
# =============================================================================
# Identical multi-stage structure to the root Dockerfile but tuned for GCP:
#  - Listens on PORT env var (Cloud Run injects this, default 8080)
#  - No NGINX — Cloud Run handles TLS termination and load balancing
#  - Credentials for GCP Secret Manager come from the attached service account
#    (Workload Identity) — no key files needed inside the image
# =============================================================================

# ---- Stage 1: Dependencies ----
FROM node:24-bookworm-slim AS deps

WORKDIR /app

# Workspace manifests are needed so npm ci installs the monorepo as the root Dockerfile does
COPY package.json package-lock.json* ./
COPY packages/ ./packages/
COPY apps/gateway/package.json ./apps/gateway/
RUN npm ci --include=dev --no-fund

# ---- Stage 2: Build ----
FROM node:24-bookworm-slim AS builder

WORKDIR /app

# Reuse dependencies from the deps stage to avoid reinstalling on source changes
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json* ./

COPY tsconfig.base.json tsconfig.json tsconfig.build.json nest-cli.json prisma.config.ts ./
COPY config/ ./config/
COPY prisma/ ./prisma/
COPY apps/gateway/ ./apps/gateway/
COPY packages/ ./packages/
COPY scripts/ ./scripts/
RUN npm run db:generate && \
    npm run build --workspace @apicenter/gateway && \
    npm prune --omit=dev && \
    npm cache clean --force

# ---- Stage 3: Production ----
FROM node:24-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --chown=node:node package.json package-lock.json* ./
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/apps/gateway/dist ./apps/gateway/dist
COPY --from=builder --chown=node:node /app/config ./config

RUN mkdir -p /app/logs && chown node:node /app/logs

USER node

# Cloud Run injects PORT at runtime (default 8080)
ENV PORT=8080
EXPOSE 8080

CMD ["node", "apps/gateway/dist/main.js"]
