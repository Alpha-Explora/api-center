  "info": {
    "title": "APICenter Gateway API",
    "description": "Gateway contracts for tribe, shared-service, and external API routing",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "KafkaPublishMessageDto": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "example": "tribe.logistics.events",
            "description": "Tenant-scoped Kafka topic name",
            "maxLength": 200
          },
          "key": {
            "type": "string",
            "example": "order-123",
            "description": "Optional Kafka message key for partition affinity"
          },
          "eventType": {
            "type": "string",
            "example": "order.created",
            "description": "Domain event type for schema governance",
            "maxLength": 120
          },
          "payload": {
            "type": "object",
            "example": {
              "orderId": "ord_123",
              "amount": 99900
            },
            "description": "Event payload object"
          },
          "sourceServiceId": {
            "type": "string",
            "example": "logistics-orders",
            "description": "Microservice that produced the event inside the authenticated tribe boundary",
            "maxLength": 64
          },
          "metadata": {
            "type": "object",
            "example": {
              "sourceService": "checkout-service"
            },
            "description": "Optional event metadata map"
          }
        },
        "required": [
          "topic",
          "eventType",
          "payload"
        ]
      },
      "TokenRequestDto": {
        "type": "object",
        "properties": {
          "tribeId": {
            "type": "string",
            "example": "payment-service",
            "maxLength": 50
          },
          "secret": {
            "type": "string",
            "example": "super-secret-value"
          }
        },
        "required": [
          "tribeId",
          "secret"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "refresh-token-value"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "RevokeTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "refresh-token-value"
          },
          "revokeAll": {
            "type": "boolean",
            "example": false,
            "default": false
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ServiceManifestDto": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "example": "payment-service"
          },
          "name": {
            "type": "string",
            "example": "Payment Service"
          },
          "baseUrl": {
            "type": "string",
            "example": "http://payment-service:4001"
          },
          "requiredScopes": {
            "example": [
              "payments:read",
              "payments:write"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exposes": {
            "example": [
              "/payments",
              "/payments/:id"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consumes": {
            "example": [
              "user-service",
              "email-service"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownerTribeId": {
            "type": "string",
            "example": "logistics",
            "description": "Tribe that owns this service. Defaults to serviceId for legacy tribe entries."
          },
          "healthCheck": {
            "type": "string",
            "example": "/health"
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          },
          "description": {
            "type": "string",
            "example": "Handles all payment operations"
          },
          "tags": {
            "example": [
              "finance",
              "pci"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownerTeam": {
            "type": "string",
            "example": "Finance Tribe"
          },
          "contact": {
            "type": "string",
            "example": "finance-platform@example.com"
          },
          "serviceTier": {
            "type": "string",
            "example": "critical",
            "enum": [
              "critical",
              "standard",
              "experimental"
            ]
          },
          "costCenter": {
            "type": "string",
            "example": "FIN-001"
          },
          "sunsetDate": {
            "type": "string",
            "example": "2026-12-31T00:00:00.000Z"
          },
          "replacementService": {
            "type": "string",
            "example": "payment-service-v2"
          },
          "serviceType": {
            "type": "string",
            "example": "tribe",
            "enum": [
              "shared",
              "tribe"
            ],
            "default": "tribe"
          }
        },
        "required": [
          "serviceId",
          "name",
          "baseUrl",
          "requiredScopes",
          "exposes"
        ]
      },
      "DeprecateServiceDto": {
        "type": "object",
        "properties": {
          "sunsetDate": {
            "type": "string",
            "example": "2026-12-31T00:00:00.000Z"
          },
          "replacementService": {
            "type": "string",
            "example": "payment-service-v2"
          }
        }
      }
    }
  }
}