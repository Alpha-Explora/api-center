{
  "version": "2026-05-11",
  "sharedServices": [
    {
      "serviceId": "payment",
      "manifest": "../api-shared-services/shared-services/manifests/payment-manifest.json",
      "wrappers": [
        "paymentCreateCheckoutSession",
        "paymentGetCheckoutSession",
        "paymentCreateRefund"
      ],
      "endpoints": [
        "/checkout/sessions",
        "/checkout/sessions/:id",
        "/payments/:id/refunds",
        "/webhooks"
      ]
    },
    {
      "serviceId": "email",
      "manifest": "../api-shared-services/shared-services/manifests/email-manifest.json",
      "wrappers": [
        "emailSend",
        "emailGetStatus"
      ],
      "endpoints": [
        "/send",
        "/templates",
        "/status"
      ]
    },
    {
      "serviceId": "sms",
      "manifest": "../api-shared-services/shared-services/manifests/sms-manifest.json",
      "wrappers": [
        "smsSend",
        "smsGetStatus"
      ],
      "endpoints": [
        "/send",
        "/status",
        "/templates"
      ]
    },
    {
      "serviceId": "gauth",
      "manifest": "../api-shared-services/shared-services/manifests/gauth-manifest.json",
      "wrappers": [
        "gauthGetAuthorizationUrl",
        "gauthExchangeCode",
        "gauthRefreshToken",
        "gauthLogout"
      ],
      "endpoints": [
        "/oauth/authorize",
        "/oauth/token",
        "/oauth/token/refresh",
        "/oauth/logout",
        "/health"
      ]
    },
    {
      "serviceId": "otp",
      "manifest": "../api-shared-services/shared-services/manifests/otp-manifest.json",
      "wrappers": [
        "otpGenerate",
        "otpVerify",
        "otpStatus"
      ],
      "endpoints": [
        "/generate",
        "/verify",
        "/status"
      ]
    },
    {
      "serviceId": "geo",
      "manifest": "../api-shared-services/shared-services/manifests/geo-manifest.json",
      "wrappers": [
        "geoGeocodeAddress",
        "geoReverseGeocode",
        "geoFenceCheck"
      ],
      "endpoints": [
        "/geocode",
        "/reverse-geocode",
        "/geofence/check"
      ]
    }
  ],
  "kafkaGovernance": {
    "requiredScopes": [
      "external:kafka:read",
      "external:kafka:write"
    ],
    "wrappers": [
      "kafkaGetGovernanceCatalog",
      "kafkaPublish"
    ],
    "endpoints": [
      "/api/v1/kafka/governance",
      "/api/v1/kafka/schemas",
      "/api/v1/kafka/publish"
    ]
  }
}
