{
  "version": "2026-05-11",
  "sharedServices": [
    {
      "serviceId": "payment",
      "manifest": "../api-shared-services/shared-services/manifests/payment-manifest.json",
      "wrappers": [
        "paymentCreateCheckoutSession",
        "paymentGetCheckoutSession",
        "paymentCreateRefund"
      ]
    },
    {
      "serviceId": "email",
      "manifest": "../api-shared-services/shared-services/manifests/email-manifest.json",
      "wrappers": [
        "emailSend",
        "emailGetStatus"
      ]
    },
    {
      "serviceId": "sms",
      "manifest": "../api-shared-services/shared-services/manifests/sms-manifest.json",
      "wrappers": [
        "smsSend",
        "smsGetStatus"
      ]
    },
    {
      "serviceId": "gauth",
      "manifest": "../api-shared-services/shared-services/manifests/gauth-manifest.json",
      "wrappers": [
        "gauthGetAuthorizationUrl",
        "gauthExchangeCode",
        "gauthRefreshToken",
        "gauthLogout"
      ]
    },
    {
      "serviceId": "otp",
      "manifest": "../api-shared-services/shared-services/manifests/otp-manifest.json",
      "wrappers": [
        "otpGenerate",
        "otpVerify",
        "otpStatus"
      ]
    }
  ],
  "kafkaGovernance": {
    "requiredScopes": [
      "external:kafka:read",
      "external:kafka:write"
    ],
    "wrappers": [
      "kafkaGetGovernanceCatalog",
      "kafkaPublish"
    ],
    "endpoints": [
      "/api/v1/kafka/governance",
      "/api/v1/kafka/schemas",
      "/api/v1/kafka/publish"
    ]
  }
}
