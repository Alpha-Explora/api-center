{
  "asyncapi": "3.1.0",
  "info": {
    "title": "APICenter Payment Events",
    "version": "2.3.0",
    "description": "Payment lifecycle events. APICenter publishes each event to its Pub/Sub topic, filters it to the application that created the resource, and delivers it to that application's webhook as a signed HTTPS POST (Standard Webhooks: webhook-id, webhook-timestamp, webhook-signature)."
  },
  "defaultContentType": "application/json",
  "servers": {
    "test": {
      "host": "pubsub.googleapis.com",
      "protocol": "googlepubsub",
      "description": "APICenter test project Pub/Sub"
    },
    "live": {
      "host": "pubsub.googleapis.com",
      "protocol": "googlepubsub",
      "description": "APICenter live project Pub/Sub"
    }
  },
  "channels": {
    "apicenter.payment-events.{environment}": {
      "address": "apicenter.payment-events.{environment}",
      "description": "Payment events, filtered per recipient application and delivered to its webhook.",
      "x-apicenter-consumer-filter": {
        "attribute": "consumerServiceId",
        "source": "control_plane.applications"
      },
      "x-apicenter-webhook-delivery": {
        "signature": "standard-webhooks-v1",
        "headers": [
          "webhook-id",
          "webhook-timestamp",
          "webhook-signature"
        ],
        "successStatus": "2xx",
        "deadLetterTopic": "apicenter.payment-events.{environment}.dead-letter",
        "maxDeliveryAttempts": 20
      },
      "parameters": {
        "environment": {
          "description": "APICenter environment.",
          "enum": [
            "test",
            "live"
          ]
        }
      },
      "messages": {
        "PaymentCheckoutPaid": {
          "$ref": "#/components/messages/PaymentCheckoutPaid"
        },
        "PaymentIntentPaid": {
          "$ref": "#/components/messages/PaymentIntentPaid"
        },
        "PaymentIntentFailed": {
          "$ref": "#/components/messages/PaymentIntentFailed"
        },
        "PaymentAllocationHeld": {
          "$ref": "#/components/messages/PaymentAllocationHeld"
        },
        "PaymentPayoutPaid": {
          "$ref": "#/components/messages/PaymentPayoutPaid"
        },
        "PaymentPayoutFailed": {
          "$ref": "#/components/messages/PaymentPayoutFailed"
        },
        "PayeeOnboardingUpdated": {
          "$ref": "#/components/messages/PayeeOnboardingUpdated"
        }
      }
    }
  },
  "operations": {
    "receivePaymentEvent": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/apicenter.payment-events.{environment}"
      },
      "messages": [
        {
          "$ref": "#/channels/apicenter.payment-events.{environment}/messages/PaymentCheckoutPaid"
        },
        {
          "$ref": "#/channels/apicenter.payment-events.{environment}/messages/PaymentIntentPaid"
        },
        {
          "$ref": "#/channels/apicenter.payment-events.{environment}/messages/PaymentIntentFailed"
        },
        {
          "$ref": "#/channels/apicenter.payment-events.{environment}/messages/PaymentAllocationHeld"
        },
        {
          "$ref": "#/channels/apicenter.payment-events.{environment}/messages/PaymentPayoutPaid"
        },
        {
          "$ref": "#/channels/apicenter.payment-events.{environment}/messages/PaymentPayoutFailed"
        },
        {
          "$ref": "#/channels/apicenter.payment-events.{environment}/messages/PayeeOnboardingUpdated"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "PaymentCheckoutPaid": {
        "name": "payment.checkout.paid",
        "title": "Checkout paid",
        "payload": {
          "allOf": [
            {
              "$ref": "#/components/schemas/PaymentEvent"
            },
            {
              "type": "object",
              "properties": {
                "eventType": {
                  "type": "string",
                  "const": "payment.checkout.paid"
                },
                "aggregateType": {
                  "type": "string",
                  "const": "checkout"
                },
                "data": {
                  "$ref": "#/components/schemas/CheckoutPaid"
                }
              }
            }
          ]
        }
      },
      "PaymentIntentPaid": {
        "name": "payment.intent.paid",
        "title": "Payment intent paid",
        "payload": {
          "allOf": [
            {
              "$ref": "#/components/schemas/PaymentEvent"
            },
            {
              "type": "object",
              "properties": {
                "eventType": {
                  "type": "string",
                  "const": "payment.intent.paid"
                },
                "aggregateType": {
                  "type": "string",
                  "const": "payment_intent"
                },
                "data": {
                  "$ref": "#/components/schemas/IntentPaid"
                }
              }
            }
          ]
        }
      },
      "PaymentIntentFailed": {
        "name": "payment.intent.failed",
        "title": "Payment intent failed",
        "description": "The customer's attempt did not go through. Create a new intent, with a new idempotency key, to let them retry.",
        "payload": {
          "allOf": [
            {
              "$ref": "#/components/schemas/PaymentEvent"
            },
            {
              "type": "object",
              "properties": {
                "eventType": {
                  "type": "string",
                  "const": "payment.intent.failed"
                },
                "aggregateType": {
                  "type": "string",
                  "const": "payment_intent"
                },
                "data": {
                  "$ref": "#/components/schemas/IntentFailed"
                }
              }
            }
          ]
        }
      },
      "PaymentAllocationHeld": {
        "name": "payment.allocation.held",
        "title": "Payment allocation held",
        "description": "A payee's share of a payment was confirmed and is held until you release it. referenceId is the payment's reference.",
        "payload": {
          "allOf": [
            {
              "$ref": "#/components/schemas/PaymentEvent"
            },
            {
              "type": "object",
              "properties": {
                "eventType": {
                  "type": "string",
                  "const": "payment.allocation.held"
                },
                "aggregateType": {
                  "type": "string",
                  "const": "allocation"
                },
                "data": {
                  "$ref": "#/components/schemas/AllocationHeld"
                }
              }
            }
          ]
        }
      },
      "PaymentPayoutPaid": {
        "name": "payment.payout.paid",
        "title": "Payout paid",
        "description": "PayMongo confirmed the transfer to the payee. referenceId is the payee's externalRef.",
        "payload": {
          "allOf": [
            {
              "$ref": "#/components/schemas/PaymentEvent"
            },
            {
              "type": "object",
              "properties": {
                "eventType": {
                  "type": "string",
                  "const": "payment.payout.paid"
                },
                "aggregateType": {
                  "type": "string",
                  "const": "payout"
                },
                "data": {
                  "$ref": "#/components/schemas/PayoutPaid"
                }
              }
            }
          ]
        }
      },
      "PaymentPayoutFailed": {
        "name": "payment.payout.failed",
        "title": "Payout failed",
        "description": "The transfer did not go through. The earnings return to the payee's balance and are paid in a later payout. referenceId is the payee's externalRef.",
        "payload": {
          "allOf": [
            {
              "$ref": "#/components/schemas/PaymentEvent"
            },
            {
              "type": "object",
              "properties": {
                "eventType": {
                  "type": "string",
                  "const": "payment.payout.failed"
                },
                "aggregateType": {
                  "type": "string",
                  "const": "payout"
                },
                "data": {
                  "$ref": "#/components/schemas/PayoutFailed"
                }
              }
            }
          ]
        }
      },
      "PayeeOnboardingUpdated": {
        "name": "payee.onboarding.updated",
        "title": "Payee wallet onboarding updated",
        "description": "Test wallet onboarding status changed. The referenceId is the payee's externalRef.",
        "payload": {
          "allOf": [
            {
              "$ref": "#/components/schemas/PaymentEvent"
            },
            {
              "type": "object",
              "properties": {
                "eventType": {
                  "type": "string",
                  "const": "payee.onboarding.updated"
                },
                "environment": {
                  "type": "string",
                  "const": "test"
                },
                "aggregateType": {
                  "type": "string",
                  "const": "payee_onboarding"
                },
                "data": {
                  "$ref": "#/components/schemas/PayeeOnboardingUpdatedData"
                }
              }
            }
          ]
        }
      }
    },
    "schemas": {
      "PayeeOnboardingUpdatedData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "onboardingId",
          "payeeId",
          "status",
          "attempts"
        ],
        "properties": {
          "onboardingId": {
            "type": "string",
            "pattern": "^lac_[A-Za-z0-9]+$"
          },
          "payeeId": {
            "type": "string",
            "pattern": "^pye_[A-Za-z0-9]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "created",
              "details_submitted",
              "verification_pending",
              "verification_failed",
              "manual_review",
              "activation_pending",
              "active",
              "declined"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PaymentEvent": {
        "type": "object",
        "required": [
          "eventId",
          "contractVersion",
          "eventType",
          "environment",
          "organizationId",
          "projectId",
          "applicationId",
          "referenceId",
          "aggregateType",
          "aggregateId",
          "aggregateVersion",
          "occurredAt",
          "data"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "description": "Stable across retries; deduplicate by it."
          },
          "contractVersion": {
            "type": "string",
            "const": "2.0"
          },
          "eventType": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "enum": [
              "test",
              "live"
            ]
          },
          "organizationId": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "applicationId": {
            "type": "string",
            "description": "The application whose call created the resource."
          },
          "referenceId": {
            "type": "string",
            "description": "The reference the application gave the resource."
          },
          "aggregateType": {
            "type": "string",
            "enum": [
              "checkout",
              "payment_intent",
              "refund",
              "subscription",
              "invoice",
              "allocation",
              "payout",
              "payee_onboarding"
            ]
          },
          "aggregateId": {
            "type": "string"
          },
          "aggregateVersion": {
            "type": "integer",
            "minimum": 1,
            "description": "Apply an event only when it is newer than the stored version."
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "CheckoutPaid": {
        "type": "object",
        "required": [
          "status",
          "checkoutId",
          "paymentId",
          "amount",
          "currency"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "paid"
          },
          "checkoutId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Minor units (centavos for PHP)."
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          }
        }
      },
      "IntentPaid": {
        "type": "object",
        "required": [
          "status",
          "paymentIntentId",
          "paymentId",
          "amount",
          "currency"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "succeeded"
          },
          "paymentIntentId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Minor units (centavos for PHP)."
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          }
        }
      },
      "IntentFailed": {
        "type": "object",
        "required": [
          "status",
          "paymentIntentId",
          "paymentId",
          "amount",
          "currency"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "failed"
          },
          "paymentIntentId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Minor units (centavos for PHP)."
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "failureCode": {
            "type": "string"
          },
          "failureMessage": {
            "type": "string"
          }
        }
      },
      "AllocationHeld": {
        "type": "object",
        "required": [
          "status",
          "allocationId",
          "payeeId",
          "paymentId",
          "amount",
          "currency"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "held"
          },
          "allocationId": {
            "type": "string"
          },
          "payeeId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Minor units (centavos for PHP)."
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          }
        }
      },
      "PayoutPaid": {
        "type": "object",
        "required": [
          "status",
          "payoutId",
          "payeeId",
          "net",
          "fee",
          "currency",
          "trigger"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "paid"
          },
          "payoutId": {
            "type": "string"
          },
          "payeeId": {
            "type": "string"
          },
          "net": {
            "type": "integer",
            "minimum": 1,
            "description": "What the payee receives, in minor units."
          },
          "fee": {
            "type": "integer",
            "minimum": 0,
            "description": "The transfer fee, in minor units. Deducted from net only when the payee bears it."
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "trigger": {
            "type": "string",
            "enum": [
              "schedule",
              "release",
              "cash_out"
            ]
          }
        }
      },
      "PayoutFailed": {
        "type": "object",
        "required": [
          "status",
          "payoutId",
          "payeeId",
          "net",
          "fee",
          "currency",
          "trigger"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "failed"
          },
          "payoutId": {
            "type": "string"
          },
          "payeeId": {
            "type": "string"
          },
          "net": {
            "type": "integer",
            "minimum": 1
          },
          "fee": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "trigger": {
            "type": "string",
            "enum": [
              "schedule",
              "release",
              "cash_out"
            ]
          },
          "failureCode": {
            "type": "string"
          }
        }
      }
    }
  }
}
