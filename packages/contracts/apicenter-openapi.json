  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "APICenterApiKey"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Unique key for safely retrying this payment mutation. Reuse the same key and request body after uncertain outcomes. A key used with a different request, an in-progress request, or an unresolved provider outcome returns HTTP 409.",
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 255
        }
      },
      "CheckoutId": {
        "name": "checkoutId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^chk_[A-Za-z0-9_]+$"
        }
      },
      "PaymentIntentId": {
        "name": "paymentIntentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^pi_[A-Za-z0-9_]+$"
        }
      },
      "CustomerId": {
        "name": "customerId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^cus_[A-Za-z0-9_]+$"
        }
      },
      "RefundId": {
        "name": "refundId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^ref_[A-Za-z0-9_]+$"
        }
      },
      "SubscriptionId": {
        "name": "subscriptionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^sub_[A-Za-z0-9_]+$"
        }
      },
      "InvoiceId": {
        "name": "invoiceId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^inv_[A-Za-z0-9_]+$"
        }
      },
      "ReferenceId": {
        "name": "referenceId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "success",
                "error"
              ],
              "properties": {
                "success": {
                  "const": false
                },
                "error": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "success",
                "error"
              ],
              "properties": {
                "success": {
                  "const": false
                },
                "error": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "IdempotencyConflict": {
        "description": "The key was used with a different request, is already processing, or the provider outcome remains unresolved. Inspect `error.code`; in particular, `PAYMENT_OUTCOME_UNKNOWN` requires reconciliation before using a new key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Pending": {
        "description": "Provider outcome is pending confirmation",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "success",
                "data"
              ],
              "properties": {
                "success": {
                  "const": true
                },
                "data": {
                  "$ref": "#/components/schemas/PendingResource"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "required": [
          "amountMinor",
          "currency"
        ],
        "properties": {
          "amountMinor": {
            "type": "integer",
            "minimum": 1,
            "description": "Final gross amount in minor PHP units."
          },
          "currency": {
            "type": "string",
            "enum": [
              "PHP"
            ]
          }
        }
      },
      "CheckoutCreateRequest": {
        "type": "object",
        "required": [
          "referenceId",
          "amount",
          "successUrl",
          "cancelUrl"
        ],
        "properties": {
          "referenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "successUrl": {
            "type": "string",
            "format": "uri"
          },
          "cancelUrl": {
            "type": "string",
            "format": "uri"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Consumer-owned correlation metadata. Do not include secrets."
          }
        }
      },
      "PaymentIntentCreateRequest": {
        "type": "object",
        "required": [
          "referenceId",
          "amount"
        ],
        "properties": {
          "referenceId": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "CustomerCreateRequest": {
        "type": "object",
        "required": [
          "customerReference",
          "email"
        ],
        "properties": {
          "customerReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "RefundCreateRequest": {
        "type": "object",
        "required": [
          "paymentId",
          "amount"
        ],
        "properties": {
          "paymentId": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "SubscriptionCreateRequest": {
        "type": "object",
        "required": [
          "customerId",
          "referenceId",
          "priceId"
        ],
        "properties": {
          "customerId": {
            "type": "string"
          },
          "referenceId": {
            "type": "string"
          },
          "priceId": {
            "type": "string",
            "description": "APICenter-managed recurring price reference."
          }
        }
      },
      "Checkout": {
        "type": "object",
        "required": [
          "checkoutId",
          "referenceId",
          "status",
          "amount"
        ],
        "properties": {
          "checkoutId": {
            "type": "string"
          },
          "referenceId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "pending",
              "paid",
              "failed",
              "cancelled",
              "expired"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "checkoutUrl": {
            "type": "string",
            "format": "uri"
          },
          "aggregateVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "PaymentIntent": {
        "type": "object",
        "required": [
          "paymentIntentId",
          "referenceId",
          "status",
          "amount"
        ],
        "properties": {
          "paymentIntentId": {
            "type": "string"
          },
          "referenceId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "requires_action",
              "pending",
              "processing",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "aggregateVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Customer": {
        "type": "object",
        "required": [
          "customerId",
          "customerReference"
        ],
        "properties": {
          "customerId": {
            "type": "string"
          },
          "customerReference": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Refund": {
        "type": "object",
        "required": [
          "refundId",
          "paymentId",
          "status",
          "amount"
        ],
        "properties": {
          "refundId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "succeeded",
              "failed"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "Subscription": {
        "type": "object",
        "required": [
          "subscriptionId",
          "customerId",
          "status"
        ],
        "properties": {
          "subscriptionId": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "past_due",
              "cancelled",
              "pending"
            ]
          },
          "currentPeriodEnd": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Invoice": {
        "type": "object",
        "required": [
          "invoiceId",
          "status",
          "amount"
        ],
        "properties": {
          "invoiceId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "open",
              "paid",
              "past_due",
              "void"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "PaymentCapabilities": {
        "type": "object",
        "required": [
          "currency",
          "paymentMethods",
          "resources"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "PHP"
            ]
          },
          "paymentMethods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PaymentRecord": {
        "type": "object",
        "required": [
          "type",
          "id",
          "projectId",
          "environment",
          "referenceId",
          "relatedResourceId",
          "amountMinor",
          "currency",
          "status",
          "createdAt"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "enum": [
              "test",
              "live"
            ]
          },
          "referenceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "amountMinor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?[0-9]+$"
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "relatedResourceId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PaymentRecordPage": {
        "type": "object",
        "required": [
          "records"
        ],
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentRecord"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "PendingResource": {
        "type": "object",
        "required": [
