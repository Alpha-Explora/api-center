{
  "name": "@alpha-explora/apicenter-sdk",
  "version": "2.0.0",
  "description": "TypeScript SDK for the APICenter public API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:consumer": "tsc --noEmit --project tests/consumer/tsconfig.json && node tests/consumer/runtime-smoke.cjs",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@alpha-explora/apicenter-contracts": "0.1.0",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
