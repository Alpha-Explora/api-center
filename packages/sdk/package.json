{
  "name": "@apicenter/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the APICenter public API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "jest --config jest.config.cjs --runInBand",
    "lint": "node -e \"console.log('SDK lint runs with the monorepo TypeScript gate')\""
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
