{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "strict": true,
    "declaration": true,
    "outDir": "dist/cjs",
    "rootDir": "src",
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ]
}
