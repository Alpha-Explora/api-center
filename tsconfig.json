{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": "./",
    "paths": {
      "@config/*": ["apps/gateway/src/config/*"],
      "@shared/*": ["apps/gateway/src/shared/*"],
      "@database/*": ["apps/gateway/src/database/*"],
      "@metrics/*": ["apps/gateway/src/metrics/*"],
      "@auth/*": ["apps/gateway/src/domains/auth-security/auth/*"],
      "@secrets/*": ["apps/gateway/src/domains/auth-security/secrets/*"],
      "@kafka/*": ["apps/gateway/src/kafka/*"],
      "@registry/*": ["apps/gateway/src/domains/catalog-registry/registry/*"],
      "@tribes/*": ["apps/gateway/src/domains/gateway-proxy/tribes/*"],
      "@external/*": ["apps/gateway/src/domains/gateway-proxy/external/*"],
      "@health/*": ["apps/gateway/src/domains/runtime-ops/health/*"],
      "@analytics/*": ["apps/gateway/src/domains/runtime-ops/analytics/*"],
      "@operations/*": ["apps/gateway/src/domains/runtime-ops/operations/*"],
      "@costs/*": ["apps/gateway/src/domains/runtime-ops/costs/*"],
      "@forecasting/*": ["apps/gateway/src/domains/runtime-ops/forecasting/*"],
      "@quotas/*": ["apps/gateway/src/domains/governance/quotas/*"],
      "@policy/*": ["apps/gateway/src/domains/governance/policy/*"],
      "@approvals/*": ["apps/gateway/src/domains/governance/approvals/*"],
      "@entitlements/*": ["apps/gateway/src/domains/governance/entitlements/*"],
      "@payments/*": ["apps/gateway/src/domains/payments/payments/*"],
      "@shared-services/*": ["apps/gateway/src/domains/gateway-proxy/shared-services/*"],
      "@governance": ["apps/gateway/src/domains/governance/index"],
      "@governance/*": ["apps/gateway/src/domains/governance/*"],
      "@domains/*": ["apps/gateway/src/domains/*"]
    }
  },
  "include": ["apps/gateway/src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}


