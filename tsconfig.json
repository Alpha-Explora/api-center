{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": "./",
    "incremental": true,
    "ignoreDeprecations": "6.0",
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "paths": {
      "@config/*": ["apps/gateway/src/config/*"],
      "@shared/*": ["apps/gateway/src/shared/*"],
      "@auth/*": ["apps/gateway/src/auth/*"],
      "@kafka/*": ["apps/gateway/src/kafka/*"],
      "@registry/*": ["apps/gateway/src/registry/*"],
      "@tribes/*": ["apps/gateway/src/tribes/*"],
      "@external/*": ["apps/gateway/src/external/*"],
      "@health/*": ["apps/gateway/src/health/*"]
    }
  },
  "include": ["apps/gateway/src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}


