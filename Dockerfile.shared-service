FROM node:24-bookworm-slim AS builder

ARG SERVICE
WORKDIR /app

# npm workspaces need the manifests of every workspace during a locked install.
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/ ./apps/
COPY packages/ ./packages/

RUN npm ci --include=dev --no-audit --no-fund \
    && npm run build --workspace @apicenter/contracts \
    && npm run build --workspace @apicenter/${SERVICE} \
    && npm prune --omit=dev --no-audit --no-fund

FROM node:24-bookworm-slim AS runner

ARG SERVICE
ENV NODE_ENV=production
ENV PORT=8080
WORKDIR /app

COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/packages/runtime ./packages/runtime
COPY --from=builder --chown=node:node /app/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=builder --chown=node:node /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=builder --chown=node:node /app/apps/${SERVICE}/package.json ./apps/${SERVICE}/package.json
COPY --from=builder --chown=node:node /app/apps/${SERVICE}/service-manifest.json ./apps/${SERVICE}/service-manifest.json
COPY --from=builder --chown=node:node /app/apps/${SERVICE}/dist ./apps/${SERVICE}/dist

WORKDIR /app/apps/${SERVICE}
USER node
EXPOSE 8080
CMD ["node", "dist/server.js"]
