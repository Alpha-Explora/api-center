# APICenter console environment template.
# Do not put real secret values here; set them in the deployment's environment.

# The gateway's admin routes. The console's server calls them with the platform credential.
API_CENTER_BASE_URL=https://api.apicenter.itsandbox.site
API_CENTER_PLATFORM_ADMIN_SECRET=<api-center-platform-admin-secret>
NEXT_PUBLIC_API_CENTER_BASE_URL=https://api.apicenter.itsandbox.site

# Sign-in. Local development can use local-dev; every deployment must use google.
MANAGEMENT_AUTH_MODE=google
# Deployment label: local, test or live.
MANAGEMENT_ENVIRONMENT=test
NEXT_PUBLIC_MANAGEMENT_ENV=test
MANAGEMENT_PUBLIC_BASE_URL=<your-console-url>

# Google sign-in. NEXT_PUBLIC_GOOGLE_CLIENT_ID is safe for the browser; the gateway must list the
# same client in MANAGEMENT_GOOGLE_CLIENT_IDS.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google-oauth-client-id>
# Optional server-side copy; defaults to NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
# Signs the 12-hour sign-in session cookie: a single-line Ed25519 private JWK with a kid. Keep it in a
# secret store. The gateway lists its public half in MANAGEMENT_SESSION_PUBLIC_KEYS. Not needed with
# MANAGEMENT_AUTH_MODE=local-dev.
MANAGEMENT_SESSION_SIGNING_KEY=
