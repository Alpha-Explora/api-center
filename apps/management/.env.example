# APICenter Console environment template
#
# Vercel usage:
# - Use MANAGEMENT_AUTH_MODE=google.
# - One Management deployment can manage test and live target rows.
# - MANAGEMENT_ENVIRONMENT labels the deployment/auth context, not the target row for an action.
# - Do not split API_CENTER_BASE_URL by target environment; target environment is carried in the route/action payload.
# - Do not put real secret values in this file. Put real values in Vercel Environment Variables.

# ---------------------------------------------------------------------------
# API Center admin gateway
# ---------------------------------------------------------------------------

API_CENTER_BASE_URL=https://api-center.itsandbox.site
API_CENTER_PLATFORM_ADMIN_SECRET=<api-center-platform-admin-secret>
APICENTER_GATEWAY_URL=https://api-center.itsandbox.site
APICENTER_OPERATOR_TOKEN=<optional-operator-token>
NEXT_PUBLIC_API_CENTER_BASE_URL=https://api-center.itsandbox.site

# ---------------------------------------------------------------------------
# Management console auth
# ---------------------------------------------------------------------------

# Local development can use local-dev. Vercel/test/live must use google.
MANAGEMENT_AUTH_MODE=google

# local, test, or live deployment label. Write routes still authorize against their requested target environment.
MANAGEMENT_ENVIRONMENT=test
MANAGEMENT_ENV=test
NEXT_PUBLIC_MANAGEMENT_ENV=test
APP_ENV=test
MANAGEMENT_PUBLIC_BASE_URL=<your-vercel-management-url>

# Google sign-in. NEXT_PUBLIC_GOOGLE_CLIENT_ID is safe for browser use.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google-oauth-client-id>

# Optional server-side duplicate. If omitted, NEXT_PUBLIC_GOOGLE_CLIENT_ID is
# used as the expected Google ID token audience.
GOOGLE_CLIENT_ID=<google-oauth-client-id>

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------

# Keep false while Confluent/AWS data pipeline work is paused. Core registry,
# secret, token, quota, and proxy workflows remain available.
DATA_PIPELINE_ENABLED=false
NEXT_PUBLIC_DATA_PIPELINE_ENABLED=false

# ---------------------------------------------------------------------------
# Kafka / Confluent environment selection
# ---------------------------------------------------------------------------

# Test: test
# Live: prod
NEXT_PUBLIC_KAFKA_TOPIC_PREFIX=test
KAFKA_TOPIC_PREFIX=test

# Confluent Cloud and Kafka cluster. Required only when DATA_PIPELINE_ENABLED=true.
# Use the Confluent values that match this Management deployment label. Target API Center rows can still be test or live.
CONFLUENT_ENVIRONMENT_ID=<confluent-environment-id>
CONFLUENT_KAFKA_CLUSTER_ID=<confluent-kafka-cluster-id>
CONFLUENT_KAFKA_REST_ENDPOINT=<confluent-kafka-rest-endpoint>
CONFLUENT_KAFKA_API_KEY=<confluent-kafka-api-key>
CONFLUENT_KAFKA_API_SECRET=<confluent-kafka-api-secret>
CONFLUENT_CLOUD_API_KEY=<confluent-cloud-api-key>
CONFLUENT_CLOUD_API_SECRET=<confluent-cloud-api-secret>

# Single APICenter data-lake connector for test.* and prod.* topics
CONFLUENT_S3_CONNECTOR_NAME=api-center-s3-sink
CONFLUENT_DEFAULT_RETENTION_MS=604800000

# ---------------------------------------------------------------------------
# Google Cloud / Secret Manager
# ---------------------------------------------------------------------------

GOOGLE_CLOUD_PROJECT=apicenter-alpha-20260623
GCP_PROJECT_ID=apicenter-alpha-20260623
API_CENTER_GCP_PROJECT_ID=apicenter-alpha-20260623
GCLOUD_PROJECT=apicenter-alpha-20260623
TRIBE_SECRET_GCP_PREFIX=api-center-tribe-secret-

# Vercel OIDC to Google Cloud. Required if Vercel should read/provision
# Secret Manager data without a service account JSON key.
GCP_PROJECT_NUMBER=<gcp-project-number>
GCP_SERVICE_ACCOUNT_EMAIL=apicenter-mgmt-provisioner@apicenter-alpha-20260623.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=<workload-identity-pool-id>
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=<workload-identity-provider-id>

# Local-only alternatives. Do not use these in Vercel unless intentionally
# running a local machine style deployment.
GCP_IMPERSONATE_SERVICE_ACCOUNT=
API_CENTER_GCP_IMPERSONATE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Deployment restart controls
# ---------------------------------------------------------------------------

# Keep false on Vercel unless kubectl access is deliberately configured.
ALLOW_DEPLOYMENT_RESTARTS=false
K8S_NAMESPACE=api-center
K8S_API_CENTER_DEPLOYMENT=api-center

# ---------------------------------------------------------------------------
# Optional local route kill switch
# ---------------------------------------------------------------------------

# Set to false only if you intentionally want to disable local provider actions.
NEXT_PUBLIC_LOCAL_MANAGEMENT_MODE=true

# ---------------------------------------------------------------------------
# Signup email verification
# ---------------------------------------------------------------------------

# Management calls APICenter's email shared-service proxy; Resend secrets and
# sender display name stay on the email-service runtime via RESEND_API_KEY and
# EMAIL_FROM_ADDRESS.
EMAIL_SERVICE_BASE_URL=https://api-center.itsandbox.site/api/v1/shared/email
SIGNUP_EMAIL_PRODUCT_NAME=APICenter
SIGNUP_EMAIL_APICENTER_ENVIRONMENT=live
SIGNUP_EMAIL_TRIBE_ID=apicenter
SIGNUP_EMAIL_SOURCE_SERVICE_ID=apicenter-management
SIGNUP_EMAIL_TRIBE_SECRET=<plaintext-secret-matching-api-center-tribe-secret-apicenter-live>

# ---------------------------------------------------------------------------
# Optional BI north-star embed
# ---------------------------------------------------------------------------
#
# The management console embeds approved BI only as a governed presentation
# layer. Power BI, Looker, or Looker Studio must read Gold or materialized
# outputs, not Raw S3.
BI_NORTH_STAR_ENABLED=false
BI_NORTH_STAR_PROVIDER=looker-studio
BI_NORTH_STAR_DASHBOARD_ID=
BI_NORTH_STAR_EMBED_URL=

# Required for BI_NORTH_STAR_PROVIDER=looker. Use the exact Looker instance
# hostname, for example analytics.example.com.
BI_NORTH_STAR_ALLOWED_HOST=

# Legacy Power BI fallback retained for existing deployments. New deployments
# should use BI_NORTH_STAR_*.
POWERBI_NORTH_STAR_ENABLED=false
POWERBI_NORTH_STAR_REPORT_ID=
POWERBI_NORTH_STAR_EMBED_URL=

# ---------------------------------------------------------------------------
# Production deployment label overrides
# ---------------------------------------------------------------------------
#
# Keep the single API Center URL even when this deployment label is live.
# Target environment for registry, secret, approval, smoke, and shared-service
# actions is selected in the action payload and must be authorized server-side.
#
# MANAGEMENT_ENVIRONMENT=live
# MANAGEMENT_ENV=live
# NEXT_PUBLIC_MANAGEMENT_ENV=live
# APP_ENV=live
# MANAGEMENT_PUBLIC_BASE_URL=<your-live-vercel-management-url>
# API_CENTER_BASE_URL=https://api-center.itsandbox.site
# NEXT_PUBLIC_API_CENTER_BASE_URL=https://api-center.itsandbox.site
# API_CENTER_PLATFORM_ADMIN_SECRET=<api-center-platform-admin-secret>
# APICENTER_GATEWAY_URL=https://api-center.itsandbox.site
# APICENTER_OPERATOR_TOKEN=<optional-operator-token>
# DATA_PIPELINE_ENABLED=false
# NEXT_PUBLIC_DATA_PIPELINE_ENABLED=false
# NEXT_PUBLIC_KAFKA_TOPIC_PREFIX=prod
# KAFKA_TOPIC_PREFIX=prod
# CONFLUENT_KAFKA_CLUSTER_ID=<confluent-kafka-cluster-id>
# CONFLUENT_KAFKA_REST_ENDPOINT=<confluent-kafka-rest-endpoint>
# CONFLUENT_KAFKA_API_KEY=<confluent-kafka-api-key>
# CONFLUENT_KAFKA_API_SECRET=<confluent-kafka-api-secret>
# CONFLUENT_S3_CONNECTOR_NAME=api-center-s3-sink

