{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@config/*": ["src/config/*"],
      "@shared/*": ["src/shared/*"],
      "@database/*": ["src/database/*"],
      "@metrics/*": ["src/metrics/*"],
      "@kafka/*": ["src/kafka/*"],

      "@auth/*": ["src/domains/auth-security/auth/*"],
      "@secrets/*": ["src/domains/auth-security/secrets/*"],
      "@registry/*": ["src/domains/catalog-registry/registry/*"],
      "@tribes/*": ["src/domains/gateway-proxy/tribes/*"],
      "@external/*": ["src/domains/gateway-proxy/external/*"],
      "@shared-services/*": ["src/domains/gateway-proxy/shared-services/*"],
      "@health/*": ["src/domains/runtime-ops/health/*"],
      "@audit/*": ["src/domains/compliance/audit/*"],
      "@analytics/*": ["src/domains/runtime-ops/analytics/*"],
      "@operations/*": ["src/domains/runtime-ops/operations/*"],
      "@quota-ledger/*": ["src/domains/runtime-ops/quota-ledger/*"],
      "@costs/*": ["src/domains/runtime-ops/costs/*"],
      "@forecasting/*": ["src/domains/runtime-ops/forecasting/*"],
      "@change-requests/*": ["src/domains/governance/change-requests/*"],
      "@quotas/*": ["src/domains/governance/quotas/*"],
      "@policy/*": ["src/domains/governance/policy/*"],
      "@approvals/*": ["src/domains/governance/approvals/*"],
      "@entitlements/*": ["src/domains/governance/entitlements/*"],
      "@payments/*": ["src/domains/payments/*"],

      "@governance": ["src/domains/governance/index"],
      "@governance/*": ["src/domains/governance/*"],
      "@domains/*": ["src/domains/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}