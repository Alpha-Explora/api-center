datasource db {
  provider = "postgresql"
  schemas = ["shared_payment"]
}

model PaymentCheckoutSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tribeId             String    @map("tribe_id")
  environment         String
  provider            String    @default("paymongo")
  providerMode        String    @map("provider_mode")
  checkoutId          String    @map("checkout_id")
  referenceId         String?   @map("reference_id")
  status              String
  amount              Int?
  currency            String   @default("PHP")
  redirectUrl         String?  @map("redirect_url")
  successUrl          String?  @map("success_url")
  cancelUrl           String?  @map("cancel_url")
  description         String?
  metadata            Json     @default("{}")
  providerMetadata    Json     @default("{}") @map("provider_metadata")
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  receipt   PaymentReceipt?
  lineItems PaymentReceiptLineItem[]

  @@unique([environment, provider, checkoutId], name: "checkout_sessions_env_provider_checkout_uidx")
  @@index([environment, tribeId, createdAt], name: "checkout_sessions_env_tribe_created_idx")
  @@index([status, createdAt], name: "checkout_sessions_status_created_idx")
  @@map("checkout_sessions")
  @@schema("shared_payment")
}

model PaymentRecord {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tribeId             String   @map("tribe_id")
  environment         String
  provider            String   @default("paymongo")
  providerMode        String   @map("provider_mode")
  paymentId           String   @map("payment_id")
  checkoutId          String?  @map("checkout_id")
  referenceId         String?  @map("reference_id")
  status              String
  amount              Int?
  currency            String   @default("PHP")
  paymentMethodType   String?  @map("payment_method_type")
  providerMetadata    Json     @default("{}") @map("provider_metadata")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  refunds PaymentRefund[]

  @@unique([environment, provider, paymentId], name: "payments_env_provider_payment_uidx")
  @@index([environment, tribeId, createdAt], name: "payments_env_tribe_created_idx")
  @@index([status, createdAt], name: "payments_status_created_idx")
  @@map("payments")
  @@schema("shared_payment")
}

model PaymentRefund {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentRowId     String?  @map("payment_row_id") @db.Uuid
  tribeId          String   @map("tribe_id")
  environment      String
  provider         String   @default("paymongo")
  providerMode     String   @map("provider_mode")
  refundId         String   @map("refund_id")
  paymentId        String   @map("payment_id")
  status           String
  amount           Int
  currency         String   @default("PHP")
  reason           String?
  providerMetadata Json     @default("{}") @map("provider_metadata")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment PaymentRecord? @relation(fields: [paymentRowId], references: [id], onDelete: SetNull)

  @@unique([environment, provider, refundId], name: "refunds_env_provider_refund_uidx")
  @@index([environment, tribeId, createdAt], name: "refunds_env_tribe_created_idx")
  @@index([paymentId], name: "refunds_payment_id_idx")
  @@map("refunds")
  @@schema("shared_payment")
}

model PaymentWebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environment     String
  provider        String    @default("paymongo")
  providerMode    String    @map("provider_mode")
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  status          String    @default("received")
  payloadHash     String?   @map("payload_hash")
  metadata        Json      @default("{}")
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  errorMessage    String?   @map("error_message")

  @@unique([environment, provider, providerEventId], name: "payment_webhook_events_env_provider_event_uidx")
  @@index([environment, eventType, receivedAt], name: "payment_webhook_events_env_type_received_idx")
  @@map("payment_webhook_events")
  @@schema("shared_payment")
}

model PaymentCustomer {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tribeId          String   @map("tribe_id")
  environment      String
  provider         String   @default("paymongo")
  providerMode     String   @map("provider_mode")
  customerId       String   @map("customer_id")
  email            String?
  phone            String?
  name             String?
  metadata         Json     @default("{}")
  providerMetadata Json     @default("{}") @map("provider_metadata")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions PaymentSubscription[]
  invoices      PaymentInvoice[]

  @@unique([environment, provider, customerId], name: "customers_env_provider_customer_uidx")
  @@index([environment, tribeId, createdAt], name: "customers_env_tribe_created_idx")
  @@map("customers")
  @@schema("shared_payment")
}

model PaymentProduct {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tribeId          String   @map("tribe_id")
  environment      String
  productId        String   @map("product_id")
  name             String
  description      String?
  active           Boolean  @default(true)
  metadata         Json     @default("{}")
  providerMetadata Json     @default("{}") @map("provider_metadata")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices PaymentPrice[]

  @@unique([environment, productId], name: "products_env_product_uidx")
  @@index([environment, tribeId, active], name: "products_env_tribe_active_idx")
  @@map("products")
  @@schema("shared_payment")
}

model PaymentPrice {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tribeId                String   @map("tribe_id")
  environment            String
  productRowId           String?  @map("product_row_id") @db.Uuid
  priceId                String   @map("price_id")
  productId              String   @map("product_id")
  amount                 Int?
  currency               String   @default("PHP")
  recurringInterval      String?  @map("recurring_interval")
  recurringIntervalCount Int?     @map("recurring_interval_count")
  trialPeriodDays        Int?     @map("trial_period_days")
  active                 Boolean  @default(true)
  metadata               Json     @default("{}")
  providerMetadata       Json     @default("{}") @map("provider_metadata")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       PaymentProduct? @relation(fields: [productRowId], references: [id], onDelete: SetNull)
  subscriptions PaymentSubscription[]

  @@unique([environment, priceId], name: "prices_env_price_uidx")
  @@index([environment, tribeId, productId], name: "prices_env_tribe_product_idx")
  @@index([tribeId, active], name: "payment_prices_tribe_active_idx")
  @@map("prices")
  @@schema("shared_payment")
}

model PaymentSubscription {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tribeId            String   @map("tribe_id")
  environment        String
  customerRowId      String?  @map("customer_row_id") @db.Uuid
  priceRowId         String?  @map("price_row_id") @db.Uuid
  provider           String   @default("paymongo")
  providerMode       String   @map("provider_mode")
  subscriptionId     String   @map("subscription_id")
  referenceId        String?  @map("reference_id")
  customerId         String   @map("customer_id")
  priceId            String   @map("price_id")
  status             String
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean  @default(false) @map("cancel_at_period_end")
  latestInvoiceId    String?  @map("latest_invoice_id")
  latestPaymentId    String?  @map("latest_payment_id")
  metadata           Json     @default("{}")
  providerMetadata   Json     @default("{}") @map("provider_metadata")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer PaymentCustomer? @relation(fields: [customerRowId], references: [id], onDelete: SetNull)
  price    PaymentPrice?    @relation(fields: [priceRowId], references: [id], onDelete: SetNull)
  invoices PaymentInvoice[]

  @@unique([environment, provider, subscriptionId], name: "subscriptions_env_provider_subscription_uidx")
  @@unique([environment, tribeId, referenceId], name: "payment_subscriptions_env_tribe_reference_uidx")
  @@index([environment, tribeId, status, createdAt], name: "subscriptions_env_tribe_status_created_idx")
  @@index([customerId], name: "payment_subscriptions_customer_id_idx")
  @@map("subscriptions")
  @@schema("shared_payment")
}

model PaymentSubscriptionEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environment     String
  provider        String    @default("paymongo")
  providerMode    String    @map("provider_mode")
  providerEventId String    @map("provider_event_id")
  subscriptionId  String?   @map("subscription_id")
  eventType       String    @map("event_type")
  status          String    @default("received")
  metadata        Json      @default("{}")
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  errorMessage    String?   @map("error_message")

  @@unique([environment, provider, providerEventId], name: "subscription_events_env_provider_event_uidx")
  @@index([environment, subscriptionId, receivedAt], name: "subscription_events_env_subscription_received_idx")
  @@index([eventType, receivedAt], name: "subscription_events_type_received_idx")
  @@map("subscription_events")
  @@schema("shared_payment")
}

model PaymentInvoice {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tribeId           String   @map("tribe_id")
  environment       String
  subscriptionRowId String? @map("subscription_row_id") @db.Uuid
  customerRowId     String?  @map("customer_row_id") @db.Uuid
  provider          String   @default("paymongo")
  providerMode      String   @map("provider_mode")
  invoiceId         String   @map("invoice_id")
  subscriptionId    String?  @map("subscription_id")
  customerId        String?  @map("customer_id")
  status            String
  amountDue         Int?     @map("amount_due")
  amountPaid        Int?     @map("amount_paid")
  currency          String   @default("PHP")
  dueAt             DateTime? @map("due_at") @db.Timestamptz(6)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  metadata          Json     @default("{}")
  providerMetadata  Json     @default("{}") @map("provider_metadata")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription PaymentSubscription? @relation(fields: [subscriptionRowId], references: [id], onDelete: SetNull)
  customer     PaymentCustomer?     @relation(fields: [customerRowId], references: [id], onDelete: SetNull)
  lineItems    PaymentInvoiceLineItem[]

  @@unique([environment, provider, invoiceId], name: "invoices_env_provider_invoice_uidx")
  @@index([environment, tribeId, createdAt], name: "invoices_env_tribe_created_idx")
  @@index([subscriptionId, createdAt], name: "payment_invoices_subscription_created_idx")
  @@map("invoices")
  @@schema("shared_payment")
}

model PaymentInvoiceLineItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  environment String
  name        String
  description String?
  quantity    Int      @default(1)
  amount      Int
  currency    String   @default("PHP")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice PaymentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([environment, invoiceId], name: "invoice_line_items_env_invoice_idx")
  @@map("invoice_line_items")
  @@schema("shared_payment")
}

model PaymentReceipt {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkoutSessionId String?  @unique @map("checkout_session_id") @db.Uuid
  tribeId           String   @map("tribe_id")
  environment       String
  receiptNumber     String?  @map("receipt_number")
  referenceId       String?  @map("reference_id")
  status            String   @default("issued")
  subtotal          Int?
  total             Int
  currency          String   @default("PHP")
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  checkoutSession PaymentCheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  lineItems       PaymentReceiptLineItem[]

  @@unique([environment, checkoutSessionId], name: "receipts_env_checkout_session_uidx")
  @@unique([environment, receiptNumber], name: "receipts_env_receipt_number_uidx")
  @@index([environment, tribeId, issuedAt], name: "receipts_env_tribe_issued_idx")
  @@map("receipts")
  @@schema("shared_payment")
}

model PaymentReceiptLineItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId         String?  @map("receipt_id") @db.Uuid
  checkoutSessionId String?  @unique @map("checkout_session_id") @db.Uuid
  environment       String
  name              String
  description       String?
  quantity          Int      @default(1)
  amount            Int
  currency          String   @default("PHP")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  receipt         PaymentReceipt?         @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  checkoutSession PaymentCheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)

  @@index([environment, receiptId], name: "receipt_line_items_env_receipt_idx")
  @@index([checkoutSessionId], name: "receipt_line_items_checkout_idx")
  @@map("receipt_line_items")
  @@schema("shared_payment")
}

model PaymentEventOutbox {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environment     String
  provider        String    @default("paymongo")
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  aggregateType   String    @map("aggregate_type")
  aggregateId     String    @map("aggregate_id")
  aggregateVersion Int      @default(1) @map("aggregate_version")
  payload         Json
  status          String    @default("pending")
  attempts        Int       @default(0)
  maxAttempts     Int       @default(8) @map("max_attempts")
  claimToken      String?   @map("claim_token") @db.Uuid
  claimedAt       DateTime? @map("claimed_at") @db.Timestamptz(6)
  availableAt     DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  lastError       String?   @map("last_error")
  ownerTribeId    String?   @map("owner_tribe_id")
  consumerServiceId String? @map("consumer_service_id")
  referenceId     String?   @map("reference_id")
  quarantineReason String?  @map("quarantine_reason")
  quarantineAttempts Int    @default(0) @map("quarantine_attempts")
  quarantinedAt   DateTime? @map("quarantined_at") @db.Timestamptz(6)
  quarantineExpiresAt DateTime? @map("quarantine_expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([environment, provider, providerEventId], name: "payment_outbox_env_provider_event_uidx")
  @@index([status, availableAt], name: "payment_outbox_status_available_idx")
  @@index([consumerServiceId, environment, status, availableAt], name: "payment_outbox_consumer_pending_idx")
  @@index([status, availableAt, createdAt], name: "payment_outbox_claimable_idx")
  @@map("payment_event_outbox")
  @@schema("shared_payment")
}
