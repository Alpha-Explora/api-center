{
  "name": "@apicenter/payments",
  "version": "1.0.0",
  "private": true,
  "description": "Private APICenter payments runtime and PayMongo adapter.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "typecheck": "node scripts/check-javascript.cjs",
    "test": "npm --prefix ../.. test -- --runInBand tests/unit/src/payments/paymongo-intents.spec.ts tests/unit/events/pubsub-publisher.spec.ts",
    "lint": "node scripts/check-javascript.cjs",
    "db:validate": "prisma validate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@apicenter/runtime": "1.0.0",
    "@google-cloud/pubsub": "^5.2.1",
    "express": "^5.2.1",
    "postgres": "^3.4.7"
  }
}

