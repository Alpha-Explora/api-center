{
  "name": "@apicenter/platform",
  "version": "1.0.0",
  "description": "APICenter - centralized gateway for tribe-to-tribe calls, shared services, auth, registry, and governed event publishing.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "turbo run build",
    "start": "node apps/gateway/dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node apps/gateway/dist/main",
    "dev": "npm run dev --workspace @apicenter/gateway",
    "lint": "turbo run lint",
    "lint:gateway": "eslint \"apps/gateway/src/**/*.ts\"",
    "pretest": "npm run build --workspace @apicenter/contracts",
    "test": "jest",
    "test:all": "npm test -- --runInBand && npm run test:workspaces",
    "test:workspaces": "npm run test --workspace @alpha-explora/apicenter-sdk && npm run test --workspace @apicenter/management && npm run test --workspace @apicenter/docs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./tests/e2e/jest-e2e.json",
    "test:integration": "jest --config ./tests/integration/jest-integration.json --runInBand",
    "typecheck": "turbo run typecheck",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migration:new": "supabase migration new",
    "db:migration:list": "supabase migration list",
    "db:migration:push": "supabase db push",
    "db:migration:push:dry": "supabase db push --dry-run",
    "db:reset": "supabase db reset",
    "db:studio": "supabase status",
    "check:boundaries": "node scripts/check-boundaries.js",
    "check:monorepo": "node scripts/check-monorepo-boundary.js",
    "check:contracts": "node scripts/check-contract-compatibility.js && node scripts/check-sdk-contracts.js",
    "contracts:validate": "ts-node scripts/contracts/validate-public-contracts.ts",
    "contracts:test": "jest --runInBand tests/unit/contracts/public-payment-contract.spec.ts",
    "smoke:post-deploy": "node scripts/post-deploy-smoke.js",
    "smoke:cloud-run": "node scripts/smoke-cloud-run-deploy.js",
    "dns:cloud-run:cutover": "node scripts/cloudflare-dns-cutover.js",
    "dns:cloud-run:rollback": "node scripts/cloudflare-dns-cutover.js --rollback",
    "cutover:cloud-run:evidence": "node scripts/record-cloud-run-cutover-evidence.js",
    "cutover:cloud-run:execute": "node scripts/execute-cloud-run-cutover.js",
    "smoke:tribe-boundary": "node scripts/smoke-tribe-boundary.js",
    "smoke:tribe-boundary:check-config": "node scripts/smoke-tribe-boundary.js --check-config",
    "smoke:tribe-quotas": "node scripts/smoke-tribe-quota.js",
    "smoke:quota": "ts-node scripts/smoke/tribe-quota-policy-smoke.ts",
    "docker:up": "docker compose -f deploy/local/docker-compose.yml up -d",
    "docker:down": "docker compose -f deploy/local/docker-compose.yml down",
    "docker:logs": "docker compose -f deploy/local/docker-compose.yml logs -f nginx api-center-1 api-center-2 api-center-3",
    "vault:init": "docker exec -it vault vault secrets enable -path=secret kv-v2 && docker exec -it vault vault secrets enable transit && docker exec -it vault vault write -f transit/keys/api-center-signing type=rsa-2048 && echo Vault initialized",
    "vault:put-keys": "docker exec -it vault vault kv put secret/api-center/dev jwt_private_key=\"$(openssl genrsa 2048)\" jwt_public_key=\"$(openssl rsa -pubout 2>/dev/null)\"",
    "docker:scale-check": "docker compose -f deploy/local/docker-compose.yml ps",
    "format": "prettier --write \"apps/gateway/src/**/*.ts\"",
    "db:verify:control-plane": "ts-node scripts/verify-control-plane-schema.ts",
    "db:test:shared-stores": "npm run build --workspace @apicenter/contracts && npm run build --workspace @apicenter/sms && npm run build --workspace @apicenter/otp && npm run build --workspace @apicenter/email && node --test tests/db/shared-service-stores.test.cjs",
    "db:test:gauth-oauth-apps": "npm run build --workspace @apicenter/contracts && npm run build --workspace @apicenter/gauth && node --test tests/db/gauth-oauth-apps.test.cjs",
    "db:purge:history": "node scripts/purge-expired-history.cjs",
    "db:test:retention": "node --test tests/db/retention-purge.test.cjs",
    "db:test:runtime-roles": "node --test tests/db/runtime-database-roles.test.cjs",
    "db:verify:replay": "node scripts/replay-supabase-migrations.cjs && ts-node scripts/verify-control-plane-schema.ts --forbid-legacy-schemas --app-role api_center_app --require-retention-policy",
    "db:load:history": "node scripts/load-history-workflows.cjs",
    "db:test:payment-outbox": "npm run build --workspace @apicenter/contracts && npm run build --workspace @apicenter/payments && node --test tests/db/payment-outbox-dispatcher.test.cjs",
    "db:test:payment-webhook": "npm run build --workspace @apicenter/contracts && npm run build --workspace @apicenter/payments && node --test tests/db/payment-webhook-outbox.test.cjs",
    "db:test:payment-schema": "node --test tests/db/payment-schema.test.cjs",
    "check:boundaries:test": "node tests/integration/scripts/check-boundaries.test.js",
    "check:environment-naming": "node scripts/check-environment-naming.js",
    "check:no-legacy-routing": "node scripts/verify-no-legacy-environment-routing.js",
    "build:gateway": "npm run build --workspace @apicenter/gateway",
    "turbo:check": "turbo run typecheck test lint",
    "gcp:provision-payment-events": "node scripts/gcp/provision-payment-events.js",
    "contracts:sync-json": "node scripts/contracts/generate-public-contract-json.cjs",
    "sdk:test": "npm run test --workspace @alpha-explora/apicenter-sdk",
    "sdk:build": "npm run build --workspace @alpha-explora/apicenter-sdk",
    "check:sdk-contracts": "node scripts/check-sdk-contracts.js",
    "docs:build": "npm run build --workspace @apicenter/docs",
    "docs:test": "npm test --workspace @apicenter/docs"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.1",
    "@google-cloud/secret-manager": "^6.1.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^4.0.0",
    "ioredis": "^5.10.0",
    "jose": "^6.2.1",
    "morgan": "^1.10.0",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.3.0",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "protobufjs": "8.2.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/tests/unit/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "apps/gateway/src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/.agents/",
      "<rootDir>/.claude/"
    ],
    "moduleNameMapper": {
      "^@config/(.*)$": "<rootDir>/apps/gateway/src/config/$1",
      "^@shared/(.*)$": "<rootDir>/apps/gateway/src/shared/$1",
      "^@database/(.*)$": "<rootDir>/apps/gateway/src/database/$1",
      "^@metrics/(.*)$": "<rootDir>/apps/gateway/src/metrics/$1",
      "^@kafka/(.*)$": "<rootDir>/apps/gateway/src/kafka/$1",
      "^@auth/(.*)$": "<rootDir>/apps/gateway/src/domains/auth-security/auth/$1",
      "^@secrets/(.*)$": "<rootDir>/apps/gateway/src/domains/auth-security/secrets/$1",
      "^@registry/(.*)$": "<rootDir>/apps/gateway/src/domains/catalog-registry/registry/$1",
      "^@tribes/(.*)$": "<rootDir>/apps/gateway/src/domains/gateway-proxy/tribes/$1",
      "^@external/(.*)$": "<rootDir>/apps/gateway/src/domains/gateway-proxy/external/$1",
      "^@shared-services/(.*)$": "<rootDir>/apps/gateway/src/domains/gateway-proxy/shared-services/$1",
      "^@health/(.*)$": "<rootDir>/apps/gateway/src/domains/runtime-ops/health/$1",
      "^@audit/(.*)$": "<rootDir>/apps/gateway/src/domains/compliance/audit/$1",
      "^@analytics/(.*)$": "<rootDir>/apps/gateway/src/domains/runtime-ops/analytics/$1",
      "^@operations/(.*)$": "<rootDir>/apps/gateway/src/domains/runtime-ops/operations/$1",
      "^@quota-ledger/(.*)$": "<rootDir>/apps/gateway/src/domains/runtime-ops/quota-ledger/$1",
      "^@costs/(.*)$": "<rootDir>/apps/gateway/src/domains/runtime-ops/costs/$1",
      "^@forecasting/(.*)$": "<rootDir>/apps/gateway/src/domains/runtime-ops/forecasting/$1",
      "^@change-requests/(.*)$": "<rootDir>/apps/gateway/src/domains/governance/change-requests/$1",
      "^@quotas/(.*)$": "<rootDir>/apps/gateway/src/domains/governance/quotas/$1",
      "^@policy/(.*)$": "<rootDir>/apps/gateway/src/domains/governance/policy/$1",
      "^@approvals/(.*)$": "<rootDir>/apps/gateway/src/domains/governance/approvals/$1",
      "^@entitlements/(.*)$": "<rootDir>/apps/gateway/src/domains/governance/entitlements/$1",
      "^@payments/(.*)$": "<rootDir>/apps/gateway/src/domains/payments/$1",
      "^@governance$": "<rootDir>/apps/gateway/src/domains/governance/index",
      "^@governance/(.*)$": "<rootDir>/apps/gateway/src/domains/governance/$1",
      "^@domains/(.*)$": "<rootDir>/apps/gateway/src/domains/$1"
    }
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
