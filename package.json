{
  "name": "@apicenter/gateway",
  "version": "1.0.0",
  "description": "APICenter - centralized gateway for tribe-to-tribe calls, shared services, auth, registry, and governed event publishing.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main",
    "dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./tests/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migration:new": "supabase migration new",
    "db:migration:list": "supabase migration list",
    "db:migration:push": "supabase db push",
    "db:migration:push:dry": "supabase db push --dry-run",
    "db:reset": "supabase db reset",
    "db:studio": "supabase status",
    "db:backfill:registry": "ts-node scripts/backfill-registry-to-postgres.ts",
    "check:boundaries": "node scripts/check-boundaries.js",
    "check:contracts": "node scripts/check-contract-compatibility.js",
    "check:data-pipeline-projection": "node scripts/data-pipeline/resolve-athena-topic-projection.js --check -TopicsFile infra/aws-data-pipeline/topic-projection-values.txt -RawTopicTablesSql infra/aws-data-pipeline/catalog/raw-topic-tables.sql --onboarding-state-file .local-state/topic-onboarding-states.json",
    "smoke:post-deploy": "node scripts/post-deploy-smoke.js",
    "smoke:gke": "node scripts/smoke-gke-deploy.js",
    "smoke:gke:check-config": "node scripts/smoke-gke-deploy.js --check-config",
    "smoke:tribe-boundary": "node scripts/smoke-tribe-boundary.js",
    "smoke:tribe-boundary:check-config": "node scripts/smoke-tribe-boundary.js --check-config",
    "smoke:tribe-quotas": "node scripts/smoke-tribe-quota.js",
    "smoke:quota": "ts-node scripts/smoke/tribe-quota-policy-smoke.ts",
    "docker:up": "docker compose -f deploy/local/docker-compose.yml up -d",
    "docker:down": "docker compose -f deploy/local/docker-compose.yml down",
    "docker:logs": "docker compose -f deploy/local/docker-compose.yml logs -f nginx api-center-1 api-center-2 api-center-3",
    "vault:init": "docker exec -it vault vault secrets enable -path=secret kv-v2 && docker exec -it vault vault secrets enable transit && docker exec -it vault vault write -f transit/keys/api-center-signing type=rsa-2048 && echo Vault initialized",
    "vault:put-keys": "docker exec -it vault vault kv put secret/api-center/dev jwt_private_key=\"$(openssl genrsa 2048)\" jwt_public_key=\"$(openssl rsa -pubout 2>/dev/null)\"",
    "docker:scale-check": "docker compose -f deploy/local/docker-compose.yml ps",
    "openapi:generate": "ts-node src/openapi/generate-openapi.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:verify:control-plane": "ts-node scripts/verify-control-plane-schema.ts",
    "check:boundaries:test": "node scripts/check-boundaries.test.js",
    "registry:verify": "node scripts/collect-registry-parity-evidence.js --fail-on-blockers",
    "check:environment-naming": "node scripts/check-environment-naming.js",
    "check:no-legacy-routing": "node scripts/verify-no-legacy-environment-routing.js",
    "smoke:spark-site:preflight": "node scripts/preflight-spark-site-deployment-smoke.js --fail-on-blockers"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1051.0",
    "@aws-sdk/credential-providers": "^3.1051.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^4.0.0",
    "ioredis": "^5.10.0",
    "jose": "^6.2.1",
    "kafkajs": "^2.2.4",
    "morgan": "^1.10.0",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.3.0",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "protobufjs": "8.2.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
