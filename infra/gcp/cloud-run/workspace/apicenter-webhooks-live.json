{
  "apiVersion": "serving.knative.dev/v1",
  "kind": "Service",
  "metadata": {
    "name": "apicenter-webhooks-live",
    "annotations": {
      "run.googleapis.com/ingress": "all"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "autoscaling.knative.dev/minScale": "0",
          "autoscaling.knative.dev/maxScale": "3",
          "run.googleapis.com/startup-cpu-boost": "true"
        }
      },
      "spec": {
        "timeoutSeconds": 30,
        "serviceAccountName": "apicenter-webhooks-runtime@apicenter-alpha-20260623.iam.gserviceaccount.com",
        "containerConcurrency": 40,
        "containers": [
          {
            "image": "asia-southeast1-docker.pkg.dev/apicenter-alpha-20260623/api-center/apicenter-webhooks:build-BUILD_ID",
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "env": [
              {
                "name": "NODE_ENV",
                "value": "production"
              },
              {
                "name": "GCP_PROJECT_ID",
                "value": "apicenter-alpha-20260623"
              }
            ],
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            },
            "startupProbe": {
              "httpGet": {
                "path": "/health",
                "port": 8080
              },
              "timeoutSeconds": 5,
              "periodSeconds": 5,
              "failureThreshold": 24
            }
          }
        ]
      }
    }
  }
}
