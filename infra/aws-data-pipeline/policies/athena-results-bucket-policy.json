{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowApprovedAthenaResultObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::api-center-athena-results/athena-results/platform/validation/*",
        "arn:aws:s3:::api-center-athena-results/athena-results/platform/materialization/*",
        "arn:aws:s3:::api-center-athena-results/athena-results/management/*",
        "arn:aws:s3:::api-center-athena-results/athena-results/tribe/*"
      ]
    },
    {
      "Sid": "AllowApprovedAthenaResultPrefixListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::api-center-athena-results",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "athena-results/*",
            "athena-results/platform/validation/*",
            "athena-results/platform/materialization/*",
            "athena-results/management/*",
            "athena-results/tribe/*"
          ]
        }
      }
    }
  ]
}
