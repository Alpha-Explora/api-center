{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunApiCenterPipelineAthenaQueries",
      "Effect": "Allow",
      "Action": [
        "athena:GetWorkGroup",
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution"
      ],
      "Resource": [
        "arn:aws:athena:ap-southeast-2:688717565427:workgroup/api-center-platform-validation-test",
        "arn:aws:athena:ap-southeast-2:688717565427:workgroup/api-center-platform-validation-prod"
      ]
    },
    {
      "Sid": "ReadGlueCatalogForCuratedPipelineViews",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartition",
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:glue:ap-southeast-2:688717565427:catalog",
        "arn:aws:glue:ap-southeast-2:688717565427:database/api_center_raw",
        "arn:aws:glue:ap-southeast-2:688717565427:database/bronze",
        "arn:aws:glue:ap-southeast-2:688717565427:database/common_silver",
        "arn:aws:glue:ap-southeast-2:688717565427:database/gold_platform",
        "arn:aws:glue:ap-southeast-2:688717565427:database/governance",
        "arn:aws:glue:ap-southeast-2:688717565427:table/api_center_raw/*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/bronze/*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/common_silver/*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/gold_platform/*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/governance/*"
      ]
    },
    {
      "Sid": "ReadRawTopicObjectsForAthenaViews",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::api-center-raw-data/topics/*"
    },
    {
      "Sid": "ListRawTopicPrefixesForAthenaViews",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::api-center-raw-data",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "topics/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadAthenaResultsBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::api-center-athena-results"
    },
    {
      "Sid": "ReadWritePlatformValidationAthenaResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::api-center-athena-results/athena-results/platform/validation/test/*",
        "arn:aws:s3:::api-center-athena-results/athena-results/platform/validation/prod/*"
      ]
    },
    {
      "Sid": "ListPlatformValidationAthenaResults",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::api-center-athena-results",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "athena-results/platform/validation/test/*",
            "athena-results/platform/validation/prod/*"
          ]
        }
      }
    }
  ]
}
