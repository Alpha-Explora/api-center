{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawTopicObjectsForValidation",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::api-center-raw-data/topics/*"
    },
    {
      "Sid": "ListRawTopicPrefixesForValidation",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::api-center-raw-data",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "topics/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadAthenaResultsBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::api-center-athena-results"
    },
    {
      "Sid": "ReadWriteAthenaResultPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::api-center-athena-results/athena-results/platform/validation/*",
        "arn:aws:s3:::api-center-athena-results/athena-results/management/*",
        "arn:aws:s3:::api-center-athena-results/athena-results/tribe/*"
      ]
    },
    {
      "Sid": "ListAthenaResultPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::api-center-athena-results",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "athena-results/*",
            "athena-results/platform/validation/*",
            "athena-results/management/*",
            "athena-results/tribe/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadCuratedDataBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::api-center-curated-data"
    },
    {
      "Sid": "ReadCuratedDataObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::api-center-curated-data/*"
    },
    {
      "Sid": "ListCuratedDataPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::api-center-curated-data",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "bronze/*",
            "silver/*",
            "gold/*"
          ]
        }
      }
    },
    {
      "Sid": "ListAthenaWorkgroups",
      "Effect": "Allow",
      "Action": [
        "athena:ListWorkGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RunAthenaQueriesAcrossApiCenterWorkgroups",
      "Effect": "Allow",
      "Action": [
        "athena:GetWorkGroup",
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:ListQueryExecutions",
        "athena:StopQueryExecution"
      ],
      "Resource": [
        "arn:aws:athena:ap-southeast-2:688717565427:workgroup/api-center-platform-validation-*",
        "arn:aws:athena:ap-southeast-2:688717565427:workgroup/api-center-materialization-*",
        "arn:aws:athena:ap-southeast-2:688717565427:workgroup/api-center-management-*",
        "arn:aws:athena:ap-southeast-2:688717565427:workgroup/api-center-tribe-*"
      ]
    },
    {
      "Sid": "ReadGlueCatalogForPipelineMapping",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartition",
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:glue:ap-southeast-2:688717565427:catalog",
        "arn:aws:glue:ap-southeast-2:688717565427:database/api_center_raw",
        "arn:aws:glue:ap-southeast-2:688717565427:database/bronze",
        "arn:aws:glue:ap-southeast-2:688717565427:database/common_silver",
        "arn:aws:glue:ap-southeast-2:688717565427:database/gold_platform",
        "arn:aws:glue:ap-southeast-2:688717565427:database/governance",
        "arn:aws:glue:ap-southeast-2:688717565427:database/materialized_platform",
        "arn:aws:glue:ap-southeast-2:688717565427:database/silver_*",
        "arn:aws:glue:ap-southeast-2:688717565427:database/gold_*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/api_center_raw/*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/bronze/*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/common_silver/*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/gold_platform/*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/governance/*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/materialized_platform/*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/silver_*/*",
        "arn:aws:glue:ap-southeast-2:688717565427:table/gold_*/*"
      ]
    },
    {
      "Sid": "ReadAccountPasswordPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:GetAccountPasswordPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ChangeOwnConsolePassword",
      "Effect": "Allow",
      "Action": [
        "iam:ChangePassword"
      ],
      "Resource": "arn:aws:iam::688717565427:user/${aws:username}"
    },
    {
      "Sid": "DenyDangerousDayToDayMutations",
      "Effect": "Deny",
      "Action": [
        "iam:Add*",
        "iam:Attach*",
        "iam:Create*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Put*",
        "iam:Remove*",
        "iam:Set*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:Update*",
        "iam:Upload*",
        "organizations:*",
        "account:*",
        "athena:CreateWorkGroup",
        "athena:UpdateWorkGroup",
        "athena:DeleteWorkGroup",
        "glue:CreateDatabase",
        "glue:UpdateDatabase",
        "glue:DeleteDatabase",
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:DeleteTable",
        "s3:PutBucketPolicy",
        "s3:PutBucketLifecycleConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:DeleteBucket",
        "s3:DeleteObject"
      ],
      "Resource": "*"
    }
  ]
}
